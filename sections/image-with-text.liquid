{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'component-melt-image-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'melt-image-slider.js' | asset_url }}" defer="defer"></script>
{{ 'component-eyebrow.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- comment -%}
    Custom image corners: override Dawn's --media-radius for this section only, so the image
    and Dawn's corner-joining rules (where image and text box meet) all pick it up.
  {%- endcomment -%}
  {%- if section.settings.image_corners == 'custom' %}
    .section-{{ section.id }}-padding {
      --media-radius: {{ section.settings.image_radius }}px;
    }
  {%- endif %}
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
  # Melt: remove_color_classes also means the text box has no visible background, so there's no
  # panel for the image to join — the class below then skips Dawn's collapse-corners, which squares
  # off the image's corners next to the text, and the image keeps all four rounded corners.
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless remove_color_classes %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          {%- comment -%}
            Melt: up to four images (Image + Image 2–4), or — Image source: Automatic — the viewed
            collection's/product's Additional images metafield (custom.additional_images), falling
            back to the manual images when it's empty. Fragrance pages read their Fragrance entry first. One image renders as before; two or more
            become a one-at-a-time slider with dots (melt-image-slider).
          {%- endcomment -%}
          {%- liquid
            assign auto_images = nil
            if section.settings.image_source == 'automatic'
              # The page's Fragrance entry (field additional_images; linked by custom.fragrance on
              # products, custom.fragrance_details on collections) first, then the page's own
              # Additional images metafield — for non-fragrance products/collections.
              assign page_resource = nil
              if request.page_type == 'collection'
                assign page_resource = collection
              elsif request.page_type == 'product'
                assign page_resource = product
              endif
              if page_resource != nil
                assign page_fragrance = page_resource.metafields.custom.fragrance.value | default: page_resource.metafields.custom.fragrance_details.value
                assign auto_images = page_fragrance.additional_images.value
                if auto_images == blank
                  assign auto_images = page_resource.metafields.custom.additional_images.value
                endif
              endif
            endif

            assign use_auto = false
            if auto_images != blank and auto_images.size > 0
              assign use_auto = true
              assign image_count = auto_images.size
              assign first_media = auto_images | first
              assign first_image = first_media.preview_image | default: first_media
            else
              assign image_count = 0
              assign first_image = nil
              assign image_keys = 'image,image_2,image_3,image_4' | split: ','
              for key in image_keys
                if section.settings[key] != blank
                  assign image_count = image_count | plus: 1
                  if first_image == nil
                    assign first_image = section.settings[key]
                  endif
                endif
              endfor
            endif

            if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in'
              assign widths = '198, 432, 642, 900, 1284, 1800'
            else
              assign widths = '165, 360, 535, 750, 1070, 1500'
            endif
          -%}
          {%- capture sizes -%}
            {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px, (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
            {%- else -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
            {%- endif -%}
          {%- endcapture -%}
          <div
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if first_image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' and image_count <= 1 %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and first_image != blank %}
              style="padding-bottom: {{ 1 | divided_by: first_image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if image_count > 1 -%}
              <melt-image-slider
                class="melt-image-slider"
                role="region"
                aria-roledescription="{{ 'sections.image_slider.carousel' | t }}"
                aria-label="{{ 'sections.image_slider.label' | t }}"
              >
                <div class="melt-image-slider__track" tabindex="0">
                  {%- if use_auto -%}
                    {%- for media in auto_images -%}
                      {%- assign slide_image = media.preview_image | default: media -%}
                      <div
                        class="melt-image-slider__slide"
                        role="group"
                        aria-roledescription="{{ 'sections.image_slider.slide' | t }}"
                        aria-label="{{ 'sections.image_slider.slide_of' | t: index: forloop.index, count: image_count }}"
                      >
                        {%- liquid
                          if forloop.first
                            assign slide_priority = fetch_priority
                            assign slide_loading = 'eager'
                          else
                            assign slide_priority = 'auto'
                            assign slide_loading = 'lazy'
                          endif
                        -%}
                        {{
                          slide_image
                          | image_url: width: 1800
                          | image_tag: sizes: sizes, widths: widths, loading: slide_loading, fetchpriority: slide_priority
                        }}
                      </div>
                    {%- endfor -%}
                  {%- else -%}
                    {%- assign slide_index = 0 -%}
                    {%- for key in image_keys -%}
                      {%- assign slide_image = section.settings[key] -%}
                      {%- if slide_image != blank -%}
                        {%- assign slide_index = slide_index | plus: 1 -%}
                        <div
                          class="melt-image-slider__slide"
                          role="group"
                          aria-roledescription="{{ 'sections.image_slider.slide' | t }}"
                          aria-label="{{ 'sections.image_slider.slide_of' | t: index: slide_index, count: image_count }}"
                        >
                          {%- liquid
                            if slide_index == 1
                              assign slide_priority = fetch_priority
                              assign slide_loading = 'eager'
                            else
                              assign slide_priority = 'auto'
                              assign slide_loading = 'lazy'
                            endif
                          -%}
                          {{
                            slide_image
                            | image_url: width: 1800
                            | image_tag: sizes: sizes, widths: widths, loading: slide_loading, fetchpriority: slide_priority
                          }}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </div>
                <div class="melt-image-slider__dots">
                  {%- for i in (1..image_count) -%}
                    <button
                      type="button"
                      class="melt-image-slider__dot"
                      aria-label="{{ 'sections.image_slider.show_slide' | t: index: i, count: image_count }}"
                      {% if forloop.first %}
                        aria-current="true"
                      {% endif %}
                    ></button>
                  {%- endfor -%}
                </div>
              </melt-image-slider>
            {%- elsif first_image != blank -%}
              {{
                first_image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content{% if section.settings.content_side_padding == 'flush-left' or section.settings.content_side_padding == 'flush-right' %} image-with-text__content--{{ section.settings.content_side_padding }}{% endif %} image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'eyebrow' -%}
                  {%- render 'melt-eyebrow',
                    text: block.settings.text,
                    color: block.settings.eyebrow_color,
                    class: 'image-with-text__eyebrow',
                    attributes: block.shopify_attributes
                  -%}
                {%- when 'scent_notes' -%}
                  {%- render 'melt-tags',
                    list: block.settings.tags_list,
                    text: block.settings.tags_text,
                    max: block.settings.max_tags,
                    color_scheme: block.settings.color_scheme,
                    colors: 'button',
                    class: 'image-with-text__tags',
                    attributes: block.shopify_attributes
                  -%}
                {%- when 'heading' -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "image_source",
      "label": "t:sections.image-with-text.settings.image_source.label",
      "info": "t:sections.image-with-text.settings.image_source.info",
      "options": [
        {
          "value": "manual",
          "label": "t:sections.image-with-text.settings.image_source.options__manual.label"
        },
        {
          "value": "automatic",
          "label": "t:sections.image-with-text.settings.image_source.options__automatic.label"
        }
      ],
      "default": "manual"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:sections.image-with-text.settings.image_2.label",
      "info": "t:sections.image-with-text.settings.image_2.info"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "t:sections.image-with-text.settings.image_3.label"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "t:sections.image-with-text.settings.image_4.label"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-with-text.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "select",
      "id": "image_corners",
      "label": "t:sections.image-with-text.settings.image_corners.label",
      "options": [
        {
          "value": "theme",
          "label": "t:sections.image-with-text.settings.image_corners.options__theme.label"
        },
        {
          "value": "custom",
          "label": "t:sections.image-with-text.settings.image_corners.options__custom.label"
        }
      ],
      "default": "theme",
      "info": "t:sections.image-with-text.settings.image_corners.info"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8,
      "label": "t:sections.image-with-text.settings.image_radius.label",
      "visible_if": "{{ section.settings.image_corners == 'custom' }}"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-with-text.settings.desktop_image_width.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.image_behavior.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header.content"
    },
    {
      "type": "select",
      "id": "content_layout",
      "options": [
        {
          "value": "no-overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__1.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__2.label"
        }
      ],
      "default": "no-overlap",
      "label": "t:sections.image-with-text.settings.content_layout.label"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "middle",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "top",
      "label": "t:sections.image-with-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "content_side_padding",
      "label": "t:sections.image-with-text.settings.content_side_padding.label",
      "info": "t:sections.image-with-text.settings.content_side_padding.info",
      "options": [
        {
          "value": "both",
          "label": "t:sections.image-with-text.settings.content_side_padding.options__both.label"
        },
        {
          "value": "flush-left",
          "label": "t:sections.image-with-text.settings.content_side_padding.options__flush_left.label"
        },
        {
          "value": "flush-right",
          "label": "t:sections.image-with-text.settings.content_side_padding.options__flush_right.label"
        }
      ],
      "default": "both"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.mobile_content_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header_colors.content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multirow.settings.container_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "t:sections.image-with-text.blocks.eyebrow.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.image-with-text.blocks.eyebrow.settings.text.label",
          "default": "t:sections.image-with-text.blocks.eyebrow.settings.text.default"
        },
        {
          "type": "color",
          "id": "eyebrow_color",
          "label": "t:sections.all.eyebrow_color.label",
          "info": "t:sections.all.eyebrow_color.info"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.image-with-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.image-with-text.blocks.heading.settings.heading.default",
          "label": "t:sections.image-with-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        }
      ]
    },
    {
      "type": "scent_notes",
      "name": "t:sections.image-with-text.blocks.scent_notes.name",
      "limit": 1,
      "settings": [
        {
          "type": "metaobject_list",
          "id": "tags_list",
          "metaobject_type": "scent_notes",
          "label": "t:sections.main-product.blocks.tags.settings.tags_list.label",
          "info": "t:sections.image-with-text.blocks.scent_notes.settings.tags_list.info"
        },
        {
          "type": "text",
          "id": "tags_text",
          "label": "t:sections.main-product.blocks.tags.settings.tags_text.label",
          "info": "t:sections.main-product.blocks.tags.settings.tags_text.info"
        },
        {
          "type": "range",
          "id": "max_tags",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 6,
          "label": "t:sections.main-product.blocks.tags.settings.max_tags.label"
        },
        {
          "type": "color_scheme",
