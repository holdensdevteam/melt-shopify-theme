      "type": "text",
      "id": "map_note",
      "label": "t:sections.melt_visit_us.settings.map_note.label",
      "default": "Loads Google Maps"
    },
    {
      "type": "header",
      "content": "t:sections.melt_visit_us.settings.header__structured_data.content"
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "t:sections.melt_visit_us.settings.structured_data.label",
      "default": true,
      "info": "t:sections.melt_visit_us.settings.structured_data.info"
    },
    {
      "type": "select",
      "id": "business_type",
      "label": "t:sections.melt_visit_us.settings.business_type.label",
      "default": "Store",
      "options": [
        {
          "value": "Store",
          "label": "t:sections.melt_visit_us.settings.business_type.options__store.label"
        },
        {
          "value": "LocalBusiness",
          "label": "t:sections.melt_visit_us.settings.business_type.options__localbusiness.label"
        }
      ]
    },
    {
      "type": "text",
      "id": "latitude",
      "label": "t:sections.melt_visit_us.settings.latitude.label",
      "default": "53.8798168"
    },
    {
      "type": "text",
      "id": "longitude",
      "label": "t:sections.melt_visit_us.settings.longitude.label",
      "default": "-2.4295273"
    },
    {
      "type": "textarea",
      "id": "same_as",
      "label": "t:sections.melt_visit_us.settings.same_as.label",
      "info": "t:sections.melt_visit_us.settings.same_as.info",
      "default": "https://www.instagram.com/themeltco/\nhttps://www.facebook.com/meltcandles"
    },
    {
      "type": "header",
      "content": "t:sections.melt_visit_us.settings.header__layout.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.melt_visit_us.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.melt_visit_us.settings.padding_bottom.label",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "hours",
      "name": "t:sections.melt_visit_us.blocks.hours.name",
      "settings": [
        {
          "type": "text",
          "id": "days",
          "label": "t:sections.melt_visit_us.blocks.hours.settings.days.label",
          "default": "Monday to Saturday"
        },
        {
          "type": "text",
          "id": "times",
          "label": "t:sections.melt_visit_us.blocks.hours.settings.times.label",
          "default": "10am – 5pm"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_visit_us.presets.name",
      "blocks": [
        {
          "type": "hours",
          "settings": {
            "days": "Monday to Saturday",
            "times": "10am – 5pm"
          }
        },
        {
          "type": "hours",
          "settings": {
            "days": "Sunday",
            "times": "12pm – 4.30pm"
          }
