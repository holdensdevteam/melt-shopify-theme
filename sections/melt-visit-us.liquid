      "label": "t:sections.melt_visit_us.settings.map_query.label",
      "info": "t:sections.melt_visit_us.settings.map_query.info"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "t:sections.melt_visit_us.settings.map_image.label",
      "info": "t:sections.melt_visit_us.settings.map_image.info"
    },
    {
      "type": "text",
      "id": "map_button_label",
      "label": "t:sections.melt_visit_us.settings.map_button_label.label",
