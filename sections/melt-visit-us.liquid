    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "t:sections.melt_visit_us.settings.phone_label.label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "telephone",
      "label": "t:sections.melt_visit_us.settings.telephone.label",
      "default": "01200 443412"
    },
    {
      "type": "header",
