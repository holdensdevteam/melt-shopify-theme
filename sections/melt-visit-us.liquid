      "id": "opens_today_text",
      "label": "t:sections.melt_visit_us.settings.opens_today_text.label",
      "default": "Closed – opens at [time] today"
    },
    {
      "type": "text",
      "id": "opens_later_text",
      "label": "t:sections.melt_visit_us.settings.opens_later_text.label",
      "default": "Closed – opens [day] at [time]"
    },
    {
      "type": "text",
      "id": "opening_hours_schema",
      "label": "t:sections.melt_visit_us.settings.opening_hours_schema.label",
