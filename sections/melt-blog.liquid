{%- comment -%}
  Melt: Blog overview (Wireframes — Blog · Blog overview).
  Thin hero (breadcrumbs, H1, standfirst) · sticky category chips · 3-across article grid ·
  numbered pagination with real ?page= URLs and "Showing X of Y articles".
  Categories are article tags: a chip links to /blogs/<blog>/tagged/<tag>, which Shopify filters
  natively, so each category has its own URL.
{%- endcomment -%}
{%- liquid
  assign category_tags = ''
  for block in section.blocks
    assign category_tags = category_tags | append: block.settings.tag | append: ','
  endfor
  assign heading = section.settings.heading | default: blog.title
-%}

{{ 'component-eyebrow.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-breadcrumbs.css' | asset_url | stylesheet_tag }}
{{ 'component-melt-article-grid.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}

<div class="melt-blog color-{{ section.settings.color_scheme }} gradient">
  <header class="melt-blog__hero page-width">
    {%- assign breadcrumb_home = 'sections.breadcrumbs.home' | t -%}
    {%- render 'melt-breadcrumbs', home_label: breadcrumb_home, separator: '/', class: 'melt-blog__breadcrumbs' -%}
    <div class="melt-blog__measure">
      <h1 class="melt-blog__title h1">{{ heading | escape }}</h1>
      {%- if section.settings.standfirst != blank -%}
        <div class="melt-blog__standfirst">{{ section.settings.standfirst }}</div>
      {%- endif -%}
    </div>
  </header>

  {%- if section.blocks.size > 0 -%}
    <nav class="melt-blog__chips page-width" aria-label="{{ section.settings.chips_label | escape }}">
      <ul class="melt-blog__chip-list list-unstyled" role="list">
        <li>
          <a href="{{ blog.url }}" class="melt-blog__chip{% if current_tags == blank %} is-active{% endif %}"{% if current_tags == blank %} aria-current="page"{% endif %}>{{ section.settings.all_label | escape }}</a>
        </li>
        {%- for block in section.blocks -%}
          {%- assign chip_tag = block.settings.tag | strip -%}
          {%- assign is_active = false -%}
          {%- if current_tags contains chip_tag -%}{%- assign is_active = true -%}{%- endif -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ blog.url }}/tagged/{{ chip_tag | handleize }}" class="melt-blog__chip{% if is_active %} is-active{% endif %}"{% if is_active %} aria-current="page"{% endif %}>
              {{- block.settings.label | default: chip_tag | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  <div class="page-width section-{{ section.id }}-padding">
    {%- paginate blog.articles by section.settings.per_page -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="melt-blog__grid melt-cards--name-{{ section.settings.card_title_size }} list-unstyled" role="list">
          {%- for article in blog.articles -%}
            {%- liquid
              assign card_lazy = true
              if forloop.index <= 3
                assign card_lazy = false
              endif
            -%}
            <li>{% render 'melt-article-card', article: article, categories: category_tags, lazy: card_lazy %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="melt-blog__empty">{{ section.settings.empty_text | escape }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="melt-blog__pagination" aria-label="{{ 'general.pagination.label' | t }}">
          <ul class="list-unstyled" role="list">
            {%- if paginate.previous -%}
              <li><a href="{{ paginate.previous.url }}" class="melt-blog__page" aria-label="{{ 'general.pagination.previous' | t }}">‹</a></li>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="melt-blog__page">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="melt-blog__page is-current" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="melt-blog__page">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}
              <li><a href="{{ paginate.next.url }}" class="melt-blog__page" aria-label="{{ 'general.pagination.next' | t }}">›</a></li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
      {%- if paginate.items > 0 -%}
        <p class="melt-blog__count">{{ 'sections.melt_blog.showing' | t: shown: blog.articles.size, total: paginate.items }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.melt_blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.melt_blog.settings.heading.label",
      "info": "t:sections.melt_blog.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "standfirst",
      "label": "t:sections.melt_blog.settings.standfirst.label",
      "default": "<p>Candle care, scent notes, what to light and when, and news from down the lane.</p>"
    },
    {
      "type": "text",
      "id": "chips_label",
      "label": "t:sections.melt_blog.settings.chips_label.label",
      "default": "Blog categories"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "t:sections.melt_blog.settings.all_label.label",
      "default": "All"
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "t:sections.melt_blog.settings.per_page.label",
      "default": 9
    },
    {
      "type": "select",
      "id": "card_title_size",
      "label": "t:sections.melt_blog.settings.card_title_size.label",
      "info": "t:sections.melt_blog.settings.card_title_size.info",
      "options": [
        { "value": "default", "label": "t:sections.collection-list.settings.card_heading_size.options__default.label" },
        { "value": "large", "label": "t:sections.collection-list.settings.card_heading_size.options__large.label" },
        { "value": "xlarge", "label": "t:sections.collection-list.settings.card_heading_size.options__xlarge.label" },
        { "value": "xxlarge", "label": "t:sections.collection-list.settings.card_heading_size.options__xxlarge.label" }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "t:sections.melt_blog.settings.empty_text.label",
      "default": "No articles here yet."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.melt_blog.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.melt_blog.settings.padding_bottom.label",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.melt_blog.blocks.category.name",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "t:sections.melt_blog.blocks.category.settings.tag.label",
          "info": "t:sections.melt_blog.blocks.category.settings.tag.info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.melt_blog.blocks.category.settings.label.label",
          "info": "t:sections.melt_blog.blocks.category.settings.label.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_blog.presets.name"
    }
  ]
}
{% endschema %}
