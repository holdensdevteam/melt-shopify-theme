{%- comment -%}
  Melt: Enquiry form (Wireframes — Proposition + form · 05 Enquiry form).
  Qualifying questions first (select blocks), then contact details, an optional message and a
  newsletter opt-in. Submits through Shopify's contact form, so enquiries arrive by email at the
  store's contact address, with every answer labelled and the page's enquiry type attached.
  The right-hand column holds "What you get" points and an "Or skip the form" contact panel.
  Anchor: #enquiry (the hero's primary button jumps here).
{%- endcomment -%}
{{ 'component-eyebrow.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-enquiry-form.css' | asset_url | stylesheet_tag }}
{%- assign form_id = 'EnquiryForm-' | append: section.id -%}

<div id="enquiry" class="melt-enquiry color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width melt-enquiry__inner">
    <div class="melt-enquiry__form">
      <h2 class="h2 melt-enquiry__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<p class="melt-enquiry__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}

      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <div class="melt-enquiry__success" tabindex="-1" autofocus>
            <h3 class="h3">{{ section.settings.success_heading | escape }}</h3>
            <p>{{ section.settings.success_text | escape }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="melt-enquiry__errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <input type="hidden" name="contact[Enquiry type]" value="{{ section.settings.enquiry_type | default: page.title | escape }}">

          <div class="melt-enquiry__grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'select' -%}
                {%- assign field_id = form_id | append: '-' | append: block.id -%}
                {%- assign opts = block.settings.options | newline_to_br | split: '<br />' -%}
                <div class="melt-enquiry__field" {{ block.shopify_attributes }}>
                  <label for="{{ field_id }}">{{ block.settings.label | escape }}{% unless block.settings.required %} <span class="melt-enquiry__optional">{{ 'sections.melt_forms.optional' | t }}</span>{% endunless %}</label>
                  <select id="{{ field_id }}" name="contact[{{ block.settings.label | escape }}]"{% if block.settings.required %} required{% endif %}>
                    <option value="">{{ 'sections.melt_forms.please_choose' | t }}</option>
                    {%- for o in opts -%}
                      {%- assign o_clean = o | strip -%}
                      {%- if o_clean != blank -%}<option value="{{ o_clean | escape }}">{{ o_clean | escape }}</option>{%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="melt-enquiry__grid melt-enquiry__grid--details">
            <div class="melt-enquiry__field melt-enquiry__field--full">
              <label for="{{ form_id }}-company">{{ 'sections.melt_forms.company' | t }}{% unless section.settings.company_required %} <span class="melt-enquiry__optional">{{ 'sections.melt_forms.optional' | t }}</span>{% endunless %}</label>
              <input id="{{ form_id }}-company" type="text" name="contact[Company]" autocomplete="organization" placeholder="{{ 'sections.melt_forms.company_placeholder' | t }}"{% if section.settings.company_required %} required{% endif %}>
            </div>
            <div class="melt-enquiry__field">
              <label for="{{ form_id }}-first">{{ 'sections.melt_forms.first_name' | t }}</label>
              <input id="{{ form_id }}-first" type="text" name="contact[First name]" autocomplete="given-name" required>
            </div>
            <div class="melt-enquiry__field">
              <label for="{{ form_id }}-last">{{ 'sections.melt_forms.last_name' | t }}</label>
              <input id="{{ form_id }}-last" type="text" name="contact[Last name]" autocomplete="family-name" required>
            </div>
            <div class="melt-enquiry__field">
              <label for="{{ form_id }}-email">{{ 'sections.melt_forms.email' | t }}</label>
              <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            </div>
            <div class="melt-enquiry__field">
              <label for="{{ form_id }}-phone">{{ 'sections.melt_forms.phone' | t }} <span class="melt-enquiry__optional">{{ 'sections.melt_forms.optional' | t }}</span></label>
              <input id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" placeholder="{{ 'sections.melt_forms.phone_placeholder' | t }}">
            </div>
            <div class="melt-enquiry__field melt-enquiry__field--full">
              <label for="{{ form_id }}-body">{{ section.settings.message_label | escape }} <span class="melt-enquiry__optional">{{ 'sections.melt_forms.optional' | t }}</span></label>
              <textarea id="{{ form_id }}-body" name="contact[Message]" rows="5" placeholder="{{ section.settings.message_placeholder | escape }}"></textarea>
            </div>
          </div>

          {%- if section.settings.consent_label != blank -%}
            <label class="melt-enquiry__consent">
              <input type="checkbox" name="contact[Newsletter opt-in]" value="Yes">
              <span>{{ section.settings.consent_label | escape }}</span>
            </label>
          {%- endif -%}

          <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
          {%- if section.settings.reply_note != blank -%}<p class="melt-enquiry__reply">{{ section.settings.reply_note | escape }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <aside class="melt-enquiry__aside">
      {%- assign has_points = false -%}
      {%- for block in section.blocks -%}{%- if block.type == 'point' -%}{%- assign has_points = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_points -%}
        <div class="melt-enquiry__panel melt-enquiry__panel--tint">
          {%- render 'melt-eyebrow', text: section.settings.points_eyebrow -%}
          <ul class="list-unstyled melt-enquiry__points" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'point' -%}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if section.settings.phone != blank or section.settings.email != blank -%}
        <div class="melt-enquiry__panel melt-enquiry__panel--outline">
          {%- render 'melt-eyebrow', text: section.settings.contact_eyebrow -%}
          {%- if section.settings.phone != blank -%}<p class="melt-enquiry__phone"><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone | escape }}</a></p>{%- endif -%}
          {%- if section.settings.hours != blank -%}<p class="melt-enquiry__hours">{{ section.settings.hours | escape }}</p>{%- endif -%}
          {%- if section.settings.email != blank -%}<p class="melt-enquiry__email"><a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a></p>{%- endif -%}
        </div>
      {%- endif -%}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.melt_enquiry_form.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.melt_enquiry_form.settings.heading.label",
      "default": "Start an enquiry"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "t:sections.melt_enquiry_form.settings.intro.label"
    },
    {
      "type": "text",
      "id": "enquiry_type",
      "label": "t:sections.melt_enquiry_form.settings.enquiry_type.label",
      "info": "t:sections.melt_enquiry_form.settings.enquiry_type.info"
    },
    {
      "type": "checkbox",
      "id": "company_required",
      "label": "t:sections.melt_enquiry_form.settings.company_required.label",
      "default": true
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "t:sections.melt_enquiry_form.settings.message_label.label",
      "default": "Anything else we should know?"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "t:sections.melt_enquiry_form.settings.message_placeholder.label",
      "default": "Branding, packaging, a deadline, an idea…"
    },
    {
      "type": "text",
      "id": "consent_label",
      "label": "t:sections.melt_enquiry_form.settings.consent_label.label",
      "info": "t:sections.melt_enquiry_form.settings.consent_label.info"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.melt_enquiry_form.settings.button_label.label",
      "default": "Send enquiry"
    },
    {
      "type": "text",
      "id": "reply_note",
      "label": "t:sections.melt_enquiry_form.settings.reply_note.label"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "t:sections.melt_enquiry_form.settings.success_heading.label",
      "default": "Thank you, we have your enquiry"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "t:sections.melt_enquiry_form.settings.success_text.label",
      "default": "We reply within one working day."
    },
    {
      "type": "header",
      "content": "t:sections.melt_enquiry_form.settings.header__right_hand_column.content"
    },
    {
      "type": "text",
      "id": "points_eyebrow",
      "label": "t:sections.melt_enquiry_form.settings.points_eyebrow.label",
      "default": "What you get"
    },
    {
      "type": "text",
      "id": "contact_eyebrow",
      "label": "t:sections.melt_enquiry_form.settings.contact_eyebrow.label",
      "default": "Or skip the form"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.melt_enquiry_form.settings.phone.label",
      "default": "01200 443377"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "t:sections.melt_enquiry_form.settings.hours.label",
      "default": "Monday to Friday, 9am – 5pm"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.melt_enquiry_form.settings.email.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "select",
      "name": "t:sections.melt_enquiry_form.blocks.select.name",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.melt_enquiry_form.blocks.select.settings.label.label",
          "default": "How many?"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "t:sections.melt_enquiry_form.blocks.select.settings.options.label",
          "info": "t:sections.melt_enquiry_form.blocks.select.settings.options.info",
          "default": "1–19\n20–49\n50–99\n100+"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:sections.melt_enquiry_form.blocks.select.settings.required.label",
          "default": true
        }
      ]
    },
    {
      "type": "point",
      "name": "t:sections.melt_enquiry_form.blocks.point.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.melt_enquiry_form.blocks.point.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_enquiry_form.presets.name"
    }
  ]
}
{% endschema %}
