{%- comment -%}
  Melt: Contact page (Wireframes — Contact).
  Hero (breadcrumbs, H1, intro, reply promise) · "Most questions are answered here" deflection
  cards (blocks) · message form with the reason first and an order-number field that only
  appears for order and delivery questions · direct contact column (call office / shop, email,
  find us, follow). On mobile the call/email routes sit above the form.
  Submits through Shopify's contact form to the store contact email. Outputs Organization
  ContactPoint structured data (LocalBusiness lives on the Shop on the Farm page).
{%- endcomment -%}
{{ 'component-eyebrow.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-breadcrumbs.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-contact.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign reasons = s.reasons | newline_to_br | split: '<br />'
  assign order_reasons = s.order_reasons | downcase
  assign form_id = 'ContactForm-' | append: section.id
-%}

<div class="melt-contact color-{{ s.color_scheme }} gradient">
  <header class="page-width melt-contact__hero">
    <div>
      {%- assign breadcrumb_home = 'sections.breadcrumbs.home' | t -%}
      {%- render 'melt-breadcrumbs', home_label: breadcrumb_home, separator: '/', class: 'melt-contact__breadcrumbs' -%}
      <h1 class="h1 melt-contact__title">{{ s.heading | default: page.title }}</h1>
      {%- if s.intro != blank -%}<div class="melt-contact__intro">{{ s.intro }}</div>{%- endif -%}
    </div>
    {%- if s.promise_title != blank -%}
      <div class="melt-contact__promise">
        <p class="melt-contact__promise-title">{{ s.promise_title | escape }}</p>
        {%- if s.promise_text != blank -%}<p class="melt-contact__promise-text">{{ s.promise_text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </header>

  {%- if section.blocks.size > 0 -%}
    <div class="page-width melt-contact__deflect">
      {%- render 'melt-eyebrow', text: s.cards_eyebrow -%}
      <ul class="list-unstyled melt-contact__cards" role="list">
        {%- for block in section.blocks -%}
          <li class="melt-contact__card" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link }}">
              <span class="melt-contact__card-title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="melt-contact__card-text">{{ block.settings.text | escape }}</span>{%- endif -%}
              <span class="melt-contact__card-link">{{ block.settings.link_label | escape }} →</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  <div class="page-width melt-contact__main">
    <div class="melt-contact__form" id="contact-form">
      <h2 class="h2 melt-contact__form-title">{{ s.form_heading | escape }}</h2>
      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <div class="melt-contact__success" tabindex="-1" autofocus>
            <h3 class="h3">{{ s.success_heading | escape }}</h3>
            <p>{{ s.success_text | escape }}</p>
            <a href="{{ routes.collections_url }}/scented-candles" class="button">{{ 'sections.melt_contact.keep_shopping' | t }}</a>
            <p><a href="/pages/faqs" class="link">{{ 'sections.melt_contact.read_faqs' | t }}</a></p>
          </div>
        {%- else -%}
          {%- if form.errors -%}<div class="melt-contact__errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="melt-contact__grid">
            <div class="melt-contact__field melt-contact__field--full">
              <label for="{{ form_id }}-reason">{{ 'sections.melt_contact.reason' | t }}</label>
              <select id="{{ form_id }}-reason" name="contact[What is it about]" required data-reason data-order-reasons="{{ order_reasons | escape }}">
                <option value="">{{ 'sections.melt_forms.please_choose' | t }}</option>
                {%- for r in reasons -%}{%- assign rc = r | strip -%}{%- if rc != blank -%}<option value="{{ rc | escape }}">{{ rc | escape }}</option>{%- endif -%}{%- endfor -%}
              </select>
            </div>
            <div class="melt-contact__field melt-contact__field--full" data-order-field hidden>
              <label for="{{ form_id }}-order">{{ 'sections.melt_contact.order_number' | t }} <span class="melt-contact__optional">{{ 'sections.melt_forms.optional' | t }}</span></label>
              <input id="{{ form_id }}-order" type="text" name="contact[Order number]" placeholder="{{ s.order_placeholder | escape }}">
            </div>
            <div class="melt-contact__field">
              <label for="{{ form_id }}-first">{{ 'sections.melt_forms.first_name' | t }}</label>
              <input id="{{ form_id }}-first" type="text" name="contact[First name]" autocomplete="given-name" required>
            </div>
            <div class="melt-contact__field">
              <label for="{{ form_id }}-last">{{ 'sections.melt_forms.last_name' | t }}</label>
              <input id="{{ form_id }}-last" type="text" name="contact[Last name]" autocomplete="family-name" required>
            </div>
            <div class="melt-contact__field melt-contact__field--full">
              <label for="{{ form_id }}-email">{{ 'sections.melt_forms.email' | t }}</label>
              <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            </div>
            <div class="melt-contact__field melt-contact__field--full">
              <label for="{{ form_id }}-phone">{{ 'sections.melt_forms.phone' | t }} <span class="melt-contact__optional">{{ 'sections.melt_forms.optional' | t }}</span></label>
              <input id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" placeholder="{{ 'sections.melt_forms.phone_placeholder' | t }}">
            </div>
            <div class="melt-contact__field melt-contact__field--full">
              <label for="{{ form_id }}-msg">{{ 'sections.melt_contact.message' | t }}</label>
              <textarea id="{{ form_id }}-msg" name="contact[Message]" rows="6" required placeholder="{{ 'sections.melt_contact.message_placeholder' | t }}"></textarea>
            </div>
          </div>
          {%- if s.consent_label != blank -%}
            <label class="melt-contact__consent">
              <input type="checkbox" name="contact[Newsletter opt-in]" value="Yes">
              <span>{{ s.consent_label | escape }}{% if s.consent_note != blank %}<small>{{ s.consent_note | escape }}</small>{% endif %}</span>
            </label>
          {%- endif -%}
          <button type="submit" class="button">{{ s.button_label | escape }}</button>
          {%- if s.reply_note != blank -%}<p class="melt-contact__reply">{{ s.reply_note | escape }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <aside class="melt-contact__aside">
      <div class="melt-contact__panel">
        {%- assign panel_eyebrow = 'sections.melt_contact.call_us' | t -%}
        {%- render 'melt-eyebrow', text: panel_eyebrow -%}
        <p class="melt-contact__line"><strong>{{ 'sections.melt_contact.office' | t }} · <a href="tel:{{ s.office_phone | remove: ' ' }}">{{ s.office_phone | escape }}</a></strong><br>{{ s.office_hours | escape }}</p>
        <p class="melt-contact__line"><strong>{{ 'sections.melt_contact.shop' | t }} · <a href="tel:{{ s.shop_phone | remove: ' ' }}">{{ s.shop_phone | escape }}</a></strong><br>{{ s.shop_hours | escape }}</p>
      </div>
      {%- if s.email != blank -%}
        <div class="melt-contact__panel">
          {%- assign panel_eyebrow = 'sections.melt_contact.email' | t -%}
        {%- render 'melt-eyebrow', text: panel_eyebrow -%}
          <p class="melt-contact__line"><strong><a href="mailto:{{ s.email }}">{{ s.email | escape }}</a></strong><br>{{ s.email_note | escape }}</p>
        </div>
      {%- endif -%}
      <div class="melt-contact__panel">
        {%- assign panel_eyebrow = 'sections.melt_contact.find_us' | t -%}
        {%- render 'melt-eyebrow', text: panel_eyebrow -%}
        <p class="melt-contact__line"><strong>{{ s.address_line_1 | escape }}</strong><br>{{ s.address_line_2 | escape }}</p>
        <a class="melt-contact__more" href="https://www.google.com/maps/dir/?api=1&destination={{ s.address_line_1 | append: ', ' | append: s.address_line_2 | url_encode }}" target="_blank" rel="noopener">{{ 'sections.melt_contact.get_directions' | t }} →</a>
      </div>
      <div class="melt-contact__panel">
        {%- assign panel_eyebrow = 'sections.melt_contact.follow' | t -%}
        {%- render 'melt-eyebrow', text: panel_eyebrow -%}
        {%- render 'social-icons', class: 'melt-contact__social' -%}
      </div>
    </aside>
  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('[data-reason]').forEach(function (select) {
      var form = select.closest('form');
      var field = form && form.querySelector('[data-order-field]');
      if (!field) return;
      var match = select.getAttribute('data-order-reasons').split(',').map(function (t) { return t.trim(); }).filter(Boolean);
      var update = function () { field.hidden = match.indexOf(select.value.toLowerCase()) === -1; };
      select.addEventListener('change', update);
      update();
    });
  })();
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }},
    {%- if s.email != blank -%}"email": {{ s.email | json }},{%- endif -%}
    "contactPoint": [
      { "@type": "ContactPoint", "telephone": {{ s.office_phone | replace: ' ', '' | replace_first: '0', '+44' | json }}, "contactType": "customer service", "areaServed": "GB", "availableLanguage": "English" },
      { "@type": "ContactPoint", "telephone": {{ s.shop_phone | replace: ' ', '' | replace_first: '0', '+44' | json }}, "contactType": "sales", "areaServed": "GB", "availableLanguage": "English" }
    ]
  }
</script>

{% schema %}
{
  "name": "t:sections.melt_contact.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.melt_contact.settings.heading.label",
      "default": "Contact us"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.melt_contact.settings.intro.label"
    },
    {
      "type": "text",
      "id": "promise_title",
      "label": "t:sections.melt_contact.settings.promise_title.label",
      "default": "We reply within one working day"
    },
    {
      "type": "text",
      "id": "promise_text",
      "label": "t:sections.melt_contact.settings.promise_text.label"
    },
    {
      "type": "text",
      "id": "cards_eyebrow",
      "label": "t:sections.melt_contact.settings.cards_eyebrow.label",
      "default": "Most questions are answered here"
    },
    {
      "type": "header",
      "content": "t:sections.melt_contact.settings.header__form.content"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "t:sections.melt_contact.settings.form_heading.label",
      "default": "Send us a message"
    },
    {
      "type": "textarea",
      "id": "reasons",
      "label": "t:sections.melt_contact.settings.reasons.label",
      "info": "t:sections.melt_contact.settings.reasons.info",
      "default": "An order\nDelivery or returns\nThe shop on the farm\nA fragrance question\nPress\nSomething else"
    },
    {
      "type": "text",
      "id": "order_reasons",
      "label": "t:sections.melt_contact.settings.order_reasons.label",
      "info": "t:sections.melt_contact.settings.order_reasons.info",
      "default": "An order, Delivery or returns"
    },
    {
      "type": "text",
      "id": "order_placeholder",
      "label": "t:sections.melt_contact.settings.order_placeholder.label",
      "default": "e.g. #1001"
    },
    {
      "type": "text",
      "id": "consent_label",
      "label": "t:sections.melt_contact.settings.consent_label.label",
      "default": "Send me the occasional letter from the farm."
    },
    {
      "type": "text",
      "id": "consent_note",
      "label": "t:sections.melt_contact.settings.consent_note.label",
      "default": "Never more than monthly, and never your details anywhere else."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.melt_contact.settings.button_label.label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "reply_note",
      "label": "t:sections.melt_contact.settings.reply_note.label",
      "default": "We reply within one working day."
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "t:sections.melt_contact.settings.success_heading.label",
      "default": "Thank you – that is with us"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "t:sections.melt_contact.settings.success_text.label",
      "default": "Someone will reply within one working day."
    },
    {
      "type": "header",
      "content": "t:sections.melt_contact.settings.header__direct_contact.content"
    },
    {
      "type": "text",
      "id": "office_phone",
      "label": "t:sections.melt_contact.settings.office_phone.label",
      "default": "01200 443377"
    },
    {
      "type": "text",
      "id": "office_hours",
      "label": "t:sections.melt_contact.settings.office_hours.label",
      "default": "Monday to Friday, 9am – 5pm"
    },
    {
      "type": "text",
      "id": "shop_phone",
      "label": "t:sections.melt_contact.settings.shop_phone.label",
      "default": "01200 443412"
    },
    {
      "type": "text",
      "id": "shop_hours",
      "label": "t:sections.melt_contact.settings.shop_hours.label",
      "default": "Mon–Sat 10am – 5pm · Sun 12pm – 4.30pm"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.melt_contact.settings.email.label"
    },
    {
      "type": "text",
      "id": "email_note",
      "label": "t:sections.melt_contact.settings.email_note.label",
      "default": "We answer within one working day"
    },
    {
      "type": "text",
      "id": "address_line_1",
      "label": "t:sections.melt_contact.settings.address_line_1.label",
      "default": "Melt Candles, Twitter Lane"
    },
    {
      "type": "text",
      "id": "address_line_2",
      "label": "t:sections.melt_contact.settings.address_line_2.label",
      "default": "Waddington, Lancashire BB7 3LQ"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.melt_contact.blocks.card.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.melt_contact.blocks.card.settings.title.label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.melt_contact.blocks.card.settings.text.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.melt_contact.blocks.card.settings.link_label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.melt_contact.blocks.card.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_contact.presets.name"
    }
  ]
}
{% endschema %}
