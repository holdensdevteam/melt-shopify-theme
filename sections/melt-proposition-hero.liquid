{%- comment -%}
  Melt: Proposition hero (Wireframes — Proposition + form · 01 Hero).
  Breadcrumbs, eyebrow, H1, standfirst, key facts (blocks), primary + secondary CTA, a short
  deadline note, and an image on the right (above the copy on mobile).
  Used by Corporate Gifting, Trade, Become a Stockist and White Label.
{%- endcomment -%}
{{ 'component-eyebrow.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-breadcrumbs.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-proposition-hero.css' | asset_url | stylesheet_tag }}

<div class="melt-prop-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="melt-prop-hero__copy">
    {%- assign breadcrumb_home = 'sections.breadcrumbs.home' | t -%}
    {%- render 'melt-breadcrumbs', home_label: breadcrumb_home, separator: '/', class: 'melt-prop-hero__breadcrumbs' -%}
    {%- render 'melt-eyebrow', text: section.settings.eyebrow, class: 'melt-prop-hero__eyebrow' -%}
    <h1 class="melt-prop-hero__title h1">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.standfirst != blank -%}
      <div class="melt-prop-hero__standfirst">{{ section.settings.standfirst }}</div>
    {%- endif -%}

    {%- assign fact_blocks = section.blocks | where: 'type', 'fact' -%}
    {%- assign chip_blocks = section.blocks | where: 'type', 'chip' -%}
    {%- if fact_blocks.size > 0 -%}
      <dl class="melt-prop-hero__facts">
        {%- for block in fact_blocks -%}
          <div class="melt-prop-hero__fact" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.value | escape }}</dt>
            <dd>{{ block.settings.label | escape }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
    {%- if chip_blocks.size > 0 -%}
      <ul class="melt-prop-hero__chips list-unstyled" role="list">
        {%- for block in chip_blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="melt-prop-hero__ctas">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_link | default: '#enquiry' }}" class="button">{{ section.settings.primary_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link }}" class="button button--secondary">{{ section.settings.secondary_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="melt-prop-hero__note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>

  <div class="melt-prop-hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 40vw, 100vw', widths: '375, 750, 1100, 1600', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.melt_proposition_hero.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.melt_proposition_hero.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.melt_proposition_hero.settings.heading.label",
      "info": "t:sections.melt_proposition_hero.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "standfirst",
      "label": "t:sections.melt_proposition_hero.settings.standfirst.label"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.melt_proposition_hero.settings.primary_label.label",
      "default": "Start an enquiry"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "t:sections.melt_proposition_hero.settings.primary_link.label",
      "info": "t:sections.melt_proposition_hero.settings.primary_link.info"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.melt_proposition_hero.settings.secondary_label.label",
      "default": "Call 01200 443377"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "t:sections.melt_proposition_hero.settings.secondary_link.label",
      "default": "tel:01200443377",
      "info": "t:sections.melt_proposition_hero.settings.secondary_link.info"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:sections.melt_proposition_hero.settings.note.label",
      "info": "t:sections.melt_proposition_hero.settings.note.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.melt_proposition_hero.settings.image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "t:sections.melt_proposition_hero.blocks.chip.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.melt_proposition_hero.blocks.chip.settings.text.label",
          "default": "10% off every order"
        }
      ]
    },
    {
      "type": "fact",
      "name": "t:sections.melt_proposition_hero.blocks.fact.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.melt_proposition_hero.blocks.fact.settings.value.label",
          "default": "From 20"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.melt_proposition_hero.blocks.fact.settings.label.label",
          "default": "units, branded"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_proposition_hero.presets.name"
    }
  ]
}
{% endschema %}
