{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- comment -%}
    Card overrides for this section only. Dawn's cards read these variables (set globally from
    Theme settings → Collection cards in theme.liquid), so redefining them here scopes the change.
  {%- endcomment -%}
  {%- if section.settings.card_style != 'theme' %}
    #CollectionList-{{ section.id }} {
      --collection-card-image-padding: {{ section.settings.card_image_padding | divided_by: 10.0 }}rem;
      --collection-card-corner-radius: {{ section.settings.card_radius | divided_by: 10.0 }}rem;
      {%- if section.settings.card_border_width > 0 %}
        --collection-card-border-width: {{ section.settings.card_border_width | divided_by: 10.0 }}rem;
        --collection-card-border-opacity: 1;
      {%- endif %}
    }
  {%- endif %}
  {%- comment -%} Heading margins (75% on mobile, like Dawn's section padding) and desktop width/side padding. {%- endcomment -%}
  #CollectionList-{{ section.id }} .title-wrapper-with-link {
    margin: {{ section.settings.heading_margin_top | times: 0.75 | round: 0 }}px {{ section.settings.heading_margin_sides | times: 0.75 | round: 0 }}px {{ section.settings.heading_margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #CollectionList-{{ section.id }} .title-wrapper-with-link {
      margin: {{ section.settings.heading_margin_top }}px {{ section.settings.heading_margin_sides }}px {{ section.settings.heading_margin_bottom }}px;
    }

    #CollectionList-{{ section.id }} .collection-list-wrapper {
      padding-left: {{ section.settings.padding_sides }}px;
      padding-right: {{ section.settings.padding_sides }}px;
      {%- if section.settings.content_width == 'full' %}
        max-width: none;
      {%- endif %}
    }
  }

  {%- if section.settings.card_text_alignment != 'theme' %}
    #CollectionList-{{ section.id }} {
      --collection-card-text-alignment: {{ section.settings.card_text_alignment }};
    }
  {%- endif %}
{%- endstyle -%}

{%- liquid
  assign card_style = settings.collection_card_style
  assign card_style_override = ''
  assign card_color_scheme_override = ''
  if section.settings.card_style != 'theme'
    assign card_style = section.settings.card_style
    assign card_style_override = section.settings.card_style
    if section.settings.card_style == 'card'
      assign card_color_scheme_override = section.settings.card_color_scheme
    endif
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div
  id="CollectionList-{{ section.id }}"
  class="collection-list-section collection-list-section--heading-{{ section.settings.heading_alignment }} collection-list-section--name-{{ section.settings.card_heading_size }}{% unless section.settings.show_arrow %} collection-list-section--no-arrow{% endunless %}{% if section.settings.card_style != 'theme' and section.settings.card_border_width > 0 %} collection-list-section--outline{% endif %} color-{{ section.settings.color_scheme }} gradient"
>
  {%- if section.settings.background_image != blank -%}
    {{
      section.settings.background_image
      | image_url: width: 3000
      | image_tag:
        class: 'collection-list-section__background',
        widths: '750, 1100, 1500, 2000, 3000',
        sizes: '100vw',
        loading: 'lazy',
        alt: ''
    }}
  {%- endif -%}
  <div class="collection-list-wrapper page-width isolate{% if show_mobile_slider %} page-width-desktop{% endif %}{% if section.settings.title == blank %} no-heading{% endif %}{% if section.settings.show_view_all == false or section.blocks.size > collections.size %} no-mobile-link{% endif %} section-{{ section.id }}-padding">
    {%- if section.settings.title != blank or section.settings.description != blank or section.settings.cta_label != blank -%}
      <div class="title-wrapper-with-link{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <div class="collection-list-section__heading">
          {%- if section.settings.title != blank -%}
            <h2
              id="SectionHeading-{{ section.id }}"
              class="collection-list-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            >
              {{ section.settings.title }}
            </h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="collection-list-section__description rte">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.show_view_all and show_mobile_slider -%}
          <a
            href="{{ routes.collections_url }}"
            id="ViewAll-{{ section.id }}"
            class="link underlined-link large-up-hide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
          >
            {{- 'sections.collection_list.view_all' | t -}}
          </a>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <a
            class="collection-list-section__cta color-{{ section.settings.cta_color_scheme }}"
            {% if section.settings.cta_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.cta_link }}"
            {% endif %}
          >
            <span>{{ section.settings.cta_label | escape }}</span>
            {%- if section.settings.cta_arrow -%}
              <span class="collection-list-section__cta-arrow">{{ 'icon-arrow-long.svg' | inline_asset_content }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        class="collection-list contains-card contains-card--collection{% if card_style == 'standard' %} contains-card--standard{% endif %} grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if section.settings.swipe_on_mobile %} slider slider--tablet grid--peek{% endif %} collection-list--{{ section.blocks.size }}-items"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign columns = section.blocks.size
          if columns > 3
            assign columns = 3
          endif
        -%}
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="collection-list__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
            {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
            {% render 'card-collection',
              card_collection: block.settings.collection,
              media_aspect_ratio: section.settings.image_ratio,
              columns: columns,
              placeholder_image: placeholder_image,
              card_style_override: card_style_override,
              card_color_scheme_override: card_color_scheme_override,
              subtitle: block.settings.subtitle,
              tags: block.settings.tags
            %}
          </li>
        {%- endfor -%}
      </ul>
      {%- if show_mobile_slider -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.show_view_all and section.blocks.size < collections.size -%}
      <div
        class="center collection-list-view-all{% if show_mobile_slider %} small-hide medium-hide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        <a
          href="{{ routes.collections_url }}"
          class="button"
          id="ViewAllButton-{{ section.id }}"
          aria-labelledby="ViewAllButton-{{ section.id }} SectionHeading-{{ section.id }}"
        >
          {{- 'sections.collection_list.view_all' | t -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 15,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.collection-list.settings.title.default",
      "label": "t:sections.collection-list.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.collection-list.settings.description.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.collection-list.settings.heading_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.collection-list.settings.heading_alignment.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.collection-list.settings.heading_alignment.options__center.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:sections.collection-list.settings.heading_margin_top.label",
      "info": "t:sections.collection-list.settings.heading_margin_top.info"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30,
      "label": "t:sections.collection-list.settings.heading_margin_bottom.label"
    },
    {
      "type": "range",
      "id": "heading_margin_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:sections.collection-list.settings.heading_margin_sides.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_cta.content",
      "info": "t:sections.collection-list.settings.header_cta.info"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.collection-list.settings.cta_label.label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.collection-list.settings.cta_link.label"
    },
    {
      "type": "checkbox",
      "id": "cta_arrow",
      "default": true,
      "label": "t:sections.collection-list.settings.cta_arrow.label"
    },
    {
      "type": "color_scheme",
      "id": "cta_color_scheme",
      "default": "scheme-2",
      "label": "t:sections.collection-list.settings.cta_color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_layout.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collection-list.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection-list.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-list.settings.image_ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.collection-list.settings.image_ratio.options__landscape.label"
        }
      ],
      "default": "square",
      "label": "t:sections.collection-list.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.collection-list.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.collection-list.settings.show_view_all.label",
      "info": "t:sections.collection-list.settings.show_view_all.info"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_cards.content",
      "info": "t:sections.collection-list.settings.header_cards.info"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.collection-list.settings.card_style.label",
      "options": [
        {
          "value": "theme",
          "label": "t:sections.collection-list.settings.card_style.options__theme.label"
        },
        {
          "value": "standard",
          "label": "t:sections.collection-list.settings.card_style.options__standard.label"
        },
        {
          "value": "card",
          "label": "t:sections.collection-list.settings.card_style.options__card.label"
        }
      ],
      "default": "theme"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:sections.collection-list.settings.card_color_scheme.label",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.card_style == 'card' }}"
    },
    {
      "type": "range",
      "id": "card_image_padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "t:sections.collection-list.settings.card_image_padding.label",
      "visible_if": "{{ section.settings.card_style != 'theme' }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8,
      "label": "t:sections.collection-list.settings.card_radius.label",
      "visible_if": "{{ section.settings.card_style != 'theme' }}"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "t:sections.collection-list.settings.card_border_width.label",
      "info": "t:sections.collection-list.settings.card_border_width.info",
      "visible_if": "{{ section.settings.card_style != 'theme' }}"
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "t:sections.collection-list.settings.card_text_alignment.label",
      "options": [
        {
          "value": "theme",
          "label": "t:sections.collection-list.settings.card_style.options__theme.label"
        },
        {
          "value": "left",
          "label": "t:sections.collection-list.settings.heading_alignment.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.collection-list.settings.heading_alignment.options__center.label"
        },
        {
          "value": "right",
          "label": "t:sections.collection-list.settings.card_text_alignment.options__right.label"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "card_heading_size",
      "label": "t:sections.collection-list.settings.card_heading_size.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.collection-list.settings.card_heading_size.options__default.label"
        },
        {
          "value": "large",
          "label": "t:sections.collection-list.settings.card_heading_size.options__large.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "default": true,
      "label": "t:sections.collection-list.settings.show_arrow.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_background.content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.collection-list.settings.background_image.label",
      "info": "t:sections.collection-list.settings.background_image.info"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection-list.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.collection-list.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.collection-list.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.collection-list.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50,
      "label": "t:sections.collection-list.settings.padding_sides.label",
      "info": "t:sections.collection-list.settings.padding_sides.info"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.collection-list.settings.content_width.label",
      "info": "t:sections.collection-list.settings.content_width.info",
      "options": [
        {
          "value": "page",
          "label": "t:sections.collection-list.settings.content_width.options__page.label"
        },
        {
          "value": "full",
          "label": "t:sections.collection-list.settings.content_width.options__full.label"
        }
      ],
      "default": "page"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.subtitle.label",
          "info": "t:sections.collection-list.blocks.featured_collection.settings.subtitle.info"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.tags.label",
          "info": "t:sections.collection-list.blocks.featured_collection.settings.tags.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.name",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
