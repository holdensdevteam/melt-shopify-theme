{{ 'section-melt-columns.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Columns: a Melt rebuild of Dawn's multicolumn using theme blocks, so the
  elements inside each column (blocks/_columns-*.liquid) can be added,
  removed and reordered in the theme editor. Used for content columns and,
  via the Testimonials preset, review carousels.
{%- endcomment -%}

{%- liquid
  assign columns_count = section.blocks.size
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0

  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and columns_count > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and columns_count > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif

  assign has_header = false
  if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.intro != blank or section.settings.custom_code != blank or section.settings.link_label != blank
    assign has_header = true
  endif
-%}

<div class="melt-columns color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding isolate">
    {%- if has_header -%}
      <div class="melt-columns__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="melt-columns__header-main">
          {%- if section.settings.eyebrow != blank -%}
            <p class="melt-columns__eyebrow caption-with-letter-spacing">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="melt-columns__title inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.title }}
            </h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="melt-columns__intro rte">{{ section.settings.intro }}</div>
          {%- endif -%}
          {%- if section.settings.custom_code != blank -%}
            <div class="melt-columns__custom">{{ section.settings.custom_code }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}
          {% render 'melt-arrow-link',
            label: section.settings.link_label,
            url: section.settings.link_url,
            class: 'melt-columns__header-link'
          %}
        {%- endif -%}
      </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter{% if show_mobile_slider == false %} page-width{% endif %}{% if show_desktop_slider == false %} page-width-desktop{% endif %}{% if show_desktop_slider %} slider-component-desktop{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        id="Slider-{{ section.id }}"
        class="melt-columns__list grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
        role="list"
        {% if show_mobile_slider or show_desktop_slider %}
          aria-label="{{ 'general.slider.name' | t }}"
        {% endif %}
      >
        {% content_for 'blocks' %}
      </ul>

      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ columns_count }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.melt_columns.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.melt_columns.settings.header_heading.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.melt_columns.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.melt_columns.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.melt_columns.settings.intro.label",
      "info": "t:sections.melt_columns.settings.intro.info"
    },
    {
      "type": "html",
      "id": "custom_code",
      "label": "t:sections.melt_columns.settings.custom_code.label",
      "info": "t:sections.melt_columns.settings.custom_code.info"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.melt_columns.settings.link_label.label",
      "info": "t:sections.melt_columns.settings.link_label.info"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:sections.melt_columns.settings.link_url.label"
    },
    {
      "type": "header",
      "content": "t:sections.melt_columns.settings.header_columns.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "column_style",
      "label": "t:sections.melt_columns.settings.column_style.label",
      "options": [
        {
          "value": "plain",
          "label": "t:sections.melt_columns.settings.column_style.options__plain.label"
        },
        {
          "value": "card",
          "label": "t:sections.melt_columns.settings.column_style.options__card.label"
        }
      ],
      "default": "plain"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:sections.melt_columns.settings.card_color_scheme.label",
      "default": "scheme-2",
      "visible_if": "{{ section.settings.column_style == 'card' }}"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.melt_columns.settings.header_carousel.content"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "t:sections.melt_columns.settings.enable_desktop_slider.label",
      "info": "t:sections.melt_columns.settings.enable_desktop_slider.info",
      "default": false
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.multicolumn.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "_columns-column"
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.melt_columns.presets.columns.name",
      "settings": {
        "title": "t:sections.melt_columns.presets.columns.title"
      },
      "blocks": [
        {
          "type": "_columns-column",
          "blocks": [
            {
              "type": "_columns-eyebrow"
            },
            {
              "type": "_columns-heading"
            },
            {
              "type": "_columns-image"
            },
            {
              "type": "_columns-text"
            },
            {
              "type": "_columns-link"
            }
          ]
        },
        {
          "type": "_columns-column",
          "blocks": [
            {
              "type": "_columns-eyebrow"
            },
            {
              "type": "_columns-heading"
            },
            {
              "type": "_columns-image"
            },
            {
              "type": "_columns-text"
            },
            {
              "type": "_columns-link"
            }
          ]
        },
        {
          "type": "_columns-column",
          "blocks": [
            {
              "type": "_columns-eyebrow"
            },
            {
              "type": "_columns-heading"
            },
            {
              "type": "_columns-image"
            },
            {
              "type": "_columns-text"
            },
            {
              "type": "_columns-link"
            }
          ]
        }
      ]
    },
    {
      "name": "t:sections.melt_columns.presets.testimonials.name",
      "settings": {
        "eyebrow": "t:sections.melt_columns.presets.testimonials.eyebrow",
        "title": "t:sections.melt_columns.presets.testimonials.title",
        "link_label": "t:sections.melt_columns.presets.testimonials.link_label",
        "column_style": "card",
        "enable_desktop_slider": true,
        "swipe_on_mobile": true
      },
      "blocks": [
        {
          "type": "_columns-column",
          "blocks": [
            {
              "type": "_columns-content",
              "settings": {
                "text": "t:sections.melt_columns.presets.testimonials.stars"
              }
            },
            {
              "type": "_columns-text",
              "settings": {
                "text": "t:sections.melt_columns.presets.testimonials.quote"
              }
            },
            {
              "type": "_columns-eyebrow",
              "settings": {
                "text": "t:sections.melt_columns.presets.testimonials.reviewer"
              }
            }
          ]
        },
        {
          "type": "_columns-column",
          "blocks": [
            {
              "type": "_columns-content",
              "settings": {
                "text": "t:sections.melt_columns.presets.testimonials.stars"
              }
            },
            {
              "type": "_columns-text",
              "settings": {
                "text": "t:sections.melt_columns.presets.testimonials.quote"
              }
            },
            {
              "type": "_columns-eyebrow",
              "settings": {
                "text": "t:sections.melt_columns.presets.testimonials.reviewer"
              }
            }
          ]
        },
        {
          "type": "_columns-column",
          "blocks": [
            {
              "type": "_columns-content",
              "settings": {
                "text": "t:sections.melt_columns.presets.testimonials.stars"
              }
            },
            {
              "type": "_columns-text",
              "settings": {
                "text": "t:sections.melt_columns.presets.testimonials.quote"
              }
            },
            {
              "type": "_columns-eyebrow",
              "settings": {
