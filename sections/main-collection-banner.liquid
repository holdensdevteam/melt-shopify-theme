{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-main-collection-banner.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Collection banner. With no blocks it renders Dawn's original banner (title, optional
  description and image — the checkbox settings). Add blocks and they take over:
  Breadcrumbs, Heading, Text, Image, Video. In the Side by side layout the Image/Video block
  sits in one column and the other blocks in the other; Stacked shows every block in order.
{%- endcomment -%}

{%- if section.blocks.size == 0 -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      .collection-hero--with-image .collection-hero__inner {
        padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
      }
    }
  {%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>
{%- else -%}
  {%- liquid
    assign has_media = false
    for block in section.blocks
      if block.type == 'image' or block.type == 'video'
        assign has_media = true
      endif
    endfor
    assign split = false
    if section.settings.layout == 'split' and has_media
      assign split = true
    endif
  -%}

  {%- style -%}
    #CollectionBanner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      #CollectionBanner-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'breadcrumbs' -%}
      {{ 'section-melt-breadcrumbs.css' | asset_url | stylesheet_tag }}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  <div
    id="CollectionBanner-{{ section.id }}"
    class="melt-banner melt-banner--{% if split %}split melt-banner--media-{{ section.settings.media_position }}{% else %}stacked{% endif %} melt-banner--align-{{ section.settings.text_alignment }} color-{{ section.settings.color_scheme }} gradient"
  >
    <div class="melt-banner__inner page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if split -%}
        <div class="melt-banner__content">
          {%- for block in section.blocks -%}
            {%- unless block.type == 'image' or block.type == 'video' -%}
              {%- render 'melt-collection-banner-block', block: block -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
        <div class="melt-banner__media-column">
          {%- for block in section.blocks -%}
            {%- if block.type == 'image' or block.type == 'video' -%}
              {%- render 'melt-collection-banner-block', block: block -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="melt-banner__content">
          {%- for block in section.blocks -%}
            {%- render 'melt-collection-banner-block', block: block -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label",
      "info": "t:sections.main-collection-banner.settings.legacy.info"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
      "info": "t:sections.main-collection-banner.settings.legacy.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-banner.settings.header_layout.content",
      "info": "t:sections.main-collection-banner.settings.header_layout.info"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.main-collection-banner.settings.layout.label",
      "options": [
        {
          "value": "stacked",
          "label": "t:sections.main-collection-banner.settings.layout.options__stacked.label"
        },
        {
          "value": "split",
          "label": "t:sections.main-collection-banner.settings.layout.options__split.label"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.main-collection-banner.settings.media_position.label",
      "options": [
        {
          "value": "right",
          "label": "t:sections.main-collection-banner.settings.media_position.options__right.label"
        },
        {
          "value": "left",
          "label": "t:sections.main-collection-banner.settings.media_position.options__left.label"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.main-collection-banner.settings.text_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.collection-list.settings.heading_alignment.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.collection-list.settings.heading_alignment.options__center.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "blocks": [
    {
      "type": "breadcrumbs",
      "name": "t:sections.main-collection-banner.blocks.breadcrumbs.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "home_label",
          "label": "t:sections.melt_breadcrumbs.settings.home_label.label",
          "default": "t:sections.melt_breadcrumbs.settings.home_label.default"
        },
        {
          "type": "text",
          "id": "separator",
          "label": "t:sections.melt_breadcrumbs.settings.separator.label",
          "default": "/"
        },
        {
          "type": "checkbox",
          "id": "structured_data",
          "default": true,
          "label": "t:sections.main-collection-banner.blocks.breadcrumbs.settings.structured_data.label",
          "info": "t:sections.main-collection-banner.blocks.breadcrumbs.settings.structured_data.info"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.main-collection-banner.blocks.heading.name",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "t:sections.main-collection-banner.blocks.heading.settings.source.label",
          "options": [
            {
              "value": "collection",
              "label": "t:sections.main-collection-banner.blocks.heading.settings.source.options__collection.label"
            },
            {
              "value": "custom",
              "label": "t:sections.main-collection-banner.blocks.heading.settings.source.options__custom.label"
            }
          ],
          "default": "collection"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.main-collection-banner.blocks.heading.settings.heading.label",
          "info": "t:sections.main-collection-banner.blocks.heading.settings.heading.info",
          "visible_if": "{{ block.settings.source == 'custom' }}"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:sections.main-product.blocks.heading.settings.heading_tag.label",
          "info": "t:sections.main-collection-banner.blocks.heading.settings.heading_tag.info",
          "options": [
            {
              "value": "h1",
              "label": "t:sections.main-product.blocks.heading.settings.heading_tag.options__h1.label"
            },
            {
              "value": "h2",
              "label": "t:sections.main-product.blocks.heading.settings.heading_tag.options__h2.label"
            },
            {
              "value": "p",
              "label": "t:sections.main-product.blocks.heading.settings.heading_tag.options__p.label"
            }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.main-collection-banner.blocks.text.name",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "t:sections.main-collection-banner.blocks.text.settings.source.label",
          "options": [
            {
              "value": "description",
              "label": "t:sections.main-collection-banner.blocks.text.settings.source.options__description.label"
            },
            {
              "value": "custom",
              "label": "t:sections.main-collection-banner.blocks.text.settings.source.options__custom.label"
            }
          ],
          "default": "description"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.main-collection-banner.blocks.text.settings.text.label",
          "info": "t:sections.main-collection-banner.blocks.text.settings.text.info",
          "visible_if": "{{ block.settings.source == 'custom' }}"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "t:sections.main-collection-banner.blocks.text.settings.text_style.label",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-collection-banner.blocks.text.settings.text_style.options__body.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.main-collection-banner.blocks.text.settings.text_style.options__subtitle.label"
            }
          ],
          "default": "body"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.main-collection-banner.blocks.image.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "t:sections.main-collection-banner.blocks.image.settings.source.label",
          "options": [
            {
              "value": "collection",
              "label": "t:sections.main-collection-banner.blocks.image.settings.source.options__collection.label"
            },
            {
              "value": "custom",
              "label": "t:sections.main-collection-banner.blocks.image.settings.source.options__custom.label"
            }
          ],
          "default": "collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.main-collection-banner.blocks.image.settings.image.label",
          "visible_if": "{{ block.settings.source == 'custom' }}"
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.label",
          "options": [
            {
              "value": "adapt",
              "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.options__adapt.label"
            },
            {
              "value": "landscape",
              "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.options__landscape.label"
            },
            {
              "value": "square",
              "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.options__square.label"
            },
            {
              "value": "portrait",
              "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.options__portrait.label"
            }
          ],
          "default": "landscape"
        }
      ]
    },
    {
      "type": "video",
      "name": "t:sections.main-collection-banner.blocks.video.name",
      "limit": 1,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.main-collection-banner.blocks.video.settings.video.label"
        },
        {
          "type": "select",
          "id": "playback",
          "label": "t:sections.main-collection-banner.blocks.video.settings.playback.label",
          "info": "t:sections.main-collection-banner.blocks.video.settings.playback.info",
          "options": [
            {
              "value": "ambient",
              "label": "t:sections.main-collection-banner.blocks.video.settings.playback.options__ambient.label"
            },
            {
              "value": "controls",
              "label": "t:sections.main-collection-banner.blocks.video.settings.playback.options__controls.label"
            }
          ],
          "default": "ambient"
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.label",
          "options": [
            {
              "value": "adapt",
              "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.options__adapt.label"
            },
            {
              "value": "landscape",
              "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.options__landscape.label"
            },
            {
              "value": "square",
              "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.options__square.label"
            },
            {
              "value": "portrait",
              "label": "t:sections.main-collection-banner.blocks.image.settings.ratio.options__portrait.label"
            }
          ],
          "default": "landscape"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:sections.main-collection-banner.blocks.video.settings.description.label",
          "info": "t:sections.main-collection-banner.blocks.video.settings.description.info"
        }
      ]
    }
  ]
}
{% endschema %}
