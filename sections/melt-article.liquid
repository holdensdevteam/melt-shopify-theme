{%- comment -%}
  Melt: Blog article (Wireframes — Blog · Blog article).
  Header in a 720px measure (breadcrumbs, category, H1, standfirst, date · read time) · full-bleed
  16:9 hero · body capped at 720px · optional collection callout and "Mentioned in this piece"
  product row, which break out wider (860px) so they read as interruptions · share and
  "More in <category>" · Keep reading (same category first) · BlogPosting structured data.

  Article metafields (Settings › Custom data › Blog posts):
  - custom.callout_collection  Collection        The "Shop the moment" callout.
  - custom.callout_text        Single line text  Optional line under the collection name.
  - custom.mentioned_products  List of products  The "Mentioned in this piece" row.
  The callout sits where the article has its first horizontal rule (<hr>), so editors place it
  from the post editor; with no rule it follows the body.
{%- endcomment -%}
{%- liquid
  assign category_tags = section.settings.category_tags | split: ','
  assign category = ''
  for cat in category_tags
    assign cat_clean = cat | strip
    if article.tags contains cat_clean
      assign category = cat_clean
      break
    endif
  endfor
  if category == blank
    assign category = article.tags | first
  endif

  assign words = article.content | strip_html | split: ' ' | size
  assign read_mins = words | divided_by: 200.0 | ceil
  if read_mins < 1
    assign read_mins = 1
  endif

  assign standfirst = article.excerpt | strip_html | strip
  assign callout_collection = article.metafields.custom.callout_collection.value
  assign mentioned = article.metafields.custom.mentioned_products.value

  assign content_parts = article.content | replace: '<hr/>', '<hr>' | replace: '<hr />', '<hr>' | split: '<hr>'
-%}

{{ 'component-eyebrow.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-breadcrumbs.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-melt-article-grid.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-article.css' | asset_url | stylesheet_tag }}

{%- capture callout -%}
  {%- if callout_collection != blank -%}
    <aside class="melt-article__callout" aria-label="{{ callout_collection.title | escape }}">
      <div class="melt-article__callout-media">
        {%- assign callout_image = callout_collection.image | default: callout_collection.featured_image -%}
        {%- if callout_image -%}
          {{ callout_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 280px, 100vw', widths: '375, 560, 900', alt: callout_collection.title }}
        {%- endif -%}
      </div>
      <div class="melt-article__callout-copy">
        {%- render 'melt-eyebrow', text: section.settings.callout_eyebrow -%}
        <h2 class="h3 melt-article__callout-title">{{ callout_collection.title | escape }}</h2>
        {%- assign callout_text = article.metafields.custom.callout_text.value | default: callout_collection.description | strip_html | truncatewords: 24 -%}
        {%- if callout_text != blank -%}<p>{{ callout_text }}</p>{%- endif -%}
        <a href="{{ callout_collection.url }}" class="button">{{ section.settings.callout_button | replace: '[collection]', callout_collection.title | escape }}</a>
      </div>
    </aside>
  {%- endif -%}
{%- endcapture -%}

<article class="melt-article color-{{ section.settings.color_scheme }} gradient">
  <header class="melt-article__header page-width">
    <div class="melt-article__measure">
      {%- assign breadcrumb_home = 'sections.breadcrumbs.home' | t -%}
      {%- render 'melt-breadcrumbs', home_label: breadcrumb_home, separator: '/', class: 'melt-article__breadcrumbs' -%}
      {%- if category != blank -%}
        {%- render 'melt-eyebrow', text: category, class: 'melt-article__category' -%}
      {%- endif -%}
      <h1 class="melt-article__title h1">{{ article.title | escape }}</h1>
      {%- if standfirst != blank -%}
        <p class="melt-article__standfirst">{{ standfirst }}</p>
      {%- endif -%}
      <p class="melt-article__byline">
        {%- if section.settings.byline != blank -%}<span>{{ section.settings.byline | escape }}</span> · {% endif -%}
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%-d %B %Y' }}</time> · {{ 'sections.melt_article.read_time' | t: minutes: read_mins }}
      </p>
    </div>
  </header>

  {%- if article.image -%}
    <div class="melt-article__hero">
      {{ article.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', alt: article.image.alt | default: article.title }}
    </div>
  {%- endif -%}

  <div class="melt-article__body page-width">
    {%- for part in content_parts -%}
      <div class="melt-article__measure rte">{{ part }}</div>
      {%- if forloop.first -%}
        {%- if content_parts.size > 1 and callout != blank -%}
          <div class="melt-article__wide">{{ callout }}</div>
        {%- endif -%}
      {%- elsif forloop.last == false -%}
        <div class="melt-article__measure rte"><hr></div>
      {%- endif -%}
    {%- endfor -%}
    {%- if content_parts.size == 1 and callout != blank -%}
      <div class="melt-article__wide">{{ callout }}</div>
    {%- endif -%}

    {%- if mentioned != blank and mentioned.size > 0 -%}
      <div class="melt-article__wide melt-article__products">
        {%- render 'melt-eyebrow', text: section.settings.products_eyebrow -%}
        <ul class="melt-article__product-track list-unstyled" role="list">
          {%- for p in mentioned limit: 8 -%}
            <li>{% render 'card-product', card_product: p, media_aspect_ratio: 'portrait', show_type_eyebrow: true, show_scent_notes: true, lazy_load: true, skip_styles: true %}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="melt-article__measure melt-article__footer">
      {%- if category != blank -%}
        <a href="{{ blog.url }}/tagged/{{ category | handleize }}" class="melt-article__more link">{{ 'sections.melt_article.more_in' | t: category: category }} →</a>
      {%- else -%}
        <a href="{{ blog.url }}" class="melt-article__more link">{{ 'sections.melt_article.more_from' | t: blog: blog.title }} →</a>
      {%- endif -%}
      <button type="button" class="melt-article__share link" data-share-url="{{ request.origin }}{{ article.url }}" data-share-title="{{ article.title | escape }}">
        <span data-share-label>{{ section.settings.share_label | escape }}</span>
      </button>
    </div>
  </div>

  {%- if section.settings.show_related -%}
    {%- assign related_ids = '' -%}
    {%- assign related_count = 0 -%}
    {%- capture related_cards -%}
      {%- if category != blank -%}
        {%- for a in blog.articles limit: 50 -%}
          {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
          {%- if a.id != article.id and a.tags contains category -%}
            <li>{% render 'melt-article-card', article: a, categories: section.settings.category_tags, show_excerpt: false %}</li>
            {%- assign related_ids = related_ids | append: ',' | append: a.id | append: ',' -%}
            {%- assign related_count = related_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- for a in blog.articles limit: 50 -%}
        {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
        {%- assign key = ',' | append: a.id | append: ',' -%}
        {%- unless a.id == article.id or related_ids contains key -%}
          <li>{% render 'melt-article-card', article: a, categories: section.settings.category_tags, show_excerpt: false %}</li>
          {%- assign related_count = related_count | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if related_count > 0 -%}
      <section class="melt-article__related page-width" aria-label="{{ section.settings.related_eyebrow | escape }}">
        {%- render 'melt-eyebrow', text: section.settings.related_eyebrow -%}
        <ul class="melt-blog__grid list-unstyled" role="list">{{ related_cards }}</ul>
      </section>
    {%- endif -%}
  {%- endif -%}
</article>

<script>
  document.querySelectorAll('[data-share-url]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-share-url');
      var label = btn.querySelector('[data-share-label]');
      if (navigator.share) { navigator.share({ title: btn.getAttribute('data-share-title'), url: url }).catch(function () {}); return; }
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function () {
          var old = label.textContent; label.textContent = {{ section.settings.copied_label | json }};
          setTimeout(function () { label.textContent = old; }, 2000);
        });
      }
    });
  });
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ request.origin | append: article.url | json }} },
    "headline": {{ article.title | json }},
    {%- if standfirst != blank -%}"description": {{ standfirst | json }},{%- endif -%}
    {%- if article.image -%}"image": [{{ article.image | image_url: width: 1920 | prepend: 'https:' | json }}],{%- endif -%}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    {%- if category != blank -%}"articleSection": {{ category | json }},{%- endif -%}
    "wordCount": {{ words }},
    "author": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ request.origin | json }} },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
      {%- if settings.logo -%},"logo": { "@type": "ImageObject", "url": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }} }{%- endif -%}
    }
  }
</script>

{% schema %}
{
  "name": "t:sections.melt_article.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "category_tags",
      "label": "t:sections.melt_article.settings.category_tags.label",
      "default": "Candle Care,Scent Notes,Moments & Occasions,Life Down the Lane",
      "info": "t:sections.melt_article.settings.category_tags.info"
    },
    {
      "type": "text",
      "id": "byline",
      "label": "t:sections.melt_article.settings.byline.label",
      "info": "t:sections.melt_article.settings.byline.info"
    },
    {
      "type": "header",
      "content": "t:sections.melt_article.settings.header__embeds.content"
    },
    {
      "type": "text",
      "id": "callout_eyebrow",
      "label": "t:sections.melt_article.settings.callout_eyebrow.label",
      "default": "Shop the moment"
    },
    {
      "type": "text",
      "id": "callout_button",
      "label": "t:sections.melt_article.settings.callout_button.label",
      "default": "Shop [collection]"
    },
    {
      "type": "text",
      "id": "products_eyebrow",
      "label": "t:sections.melt_article.settings.products_eyebrow.label",
      "default": "Mentioned in this piece"
    },
    {
      "type": "header",
      "content": "t:sections.melt_article.settings.header__footer.content"
    },
    {
      "type": "text",
      "id": "share_label",
      "label": "t:sections.melt_article.settings.share_label.label",
      "default": "Share"
    },
    {
      "type": "text",
      "id": "copied_label",
      "label": "t:sections.melt_article.settings.copied_label.label",
      "default": "Link copied"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "t:sections.melt_article.settings.show_related.label",
      "default": true
    },
    {
      "type": "text",
      "id": "related_eyebrow",
      "label": "t:sections.melt_article.settings.related_eyebrow.label",
      "default": "Keep reading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
