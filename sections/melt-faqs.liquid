{{ 'section-melt-faqs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign use_list = false
  assign faq_list = nil
  if section.settings.source == 'automatic'
    if request.page_type == 'product'
      assign faq_list = product.metafields.custom.faqs.value
    elsif request.page_type == 'collection'
      assign faq_list = collection.metafields.custom.faqs.value
    endif
    if faq_list != blank and faq_list.size > 0
      assign use_list = true
    endif
  endif
  assign hide_section = false
  if section.settings.source == 'automatic' and use_list == false
    assign hide_section = true
  endif
-%}

{%- comment -%}
  FAQs: intro (title, description, link) on the left; questions on the right, each a <details>
  that starts collapsed. Questions setting: Manual (Question blocks) or Automatic (the viewed
  collection's or product's custom.faqs metafield, one question per entry; section hidden if none).
  Also outputs FAQPage JSON-LD from the same questions and answers (Structured data setting) —
  keep it to one FAQ section per page that outputs it.
{%- endcomment -%}

{%- if hide_section -%}
  {%- if request.design_mode -%}
    <div class="page-width melt-faqs__empty-note">
      <p>{{ 'sections.faqs.automatic_empty' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
{%- style -%}
  #Faqs-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #Faqs-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="Faqs-{{ section.id }}" class="melt-faqs color-{{ section.settings.color_scheme }} gradient">
  <div class="melt-faqs__inner page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- if section.settings.title != blank or section.settings.description != blank or section.settings.link_label != blank -%}
      <div class="melt-faqs__intro">
        {%- if section.settings.title != blank -%}
          <h2 class="melt-faqs__title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="melt-faqs__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
        {%- render 'melt-heading-link',
          label: section.settings.link_label,
          url: section.settings.link_url,
          color_scheme: section.settings.link_color_scheme,
          show_arrow: section.settings.link_arrow
        -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Questions: "Manual" uses the Question blocks; "Automatic" reads the page's own FAQs metafield
      (custom.faqs — a list of FAQs metaobjects with question and answer fields) from the collection
      or product being viewed, one question per entry. The FAQPage JSON-LD is built in the same
      pass, so it always matches what's shown.
    {%- endcomment -%}
    {%- assign faq_json = '' -%}
    <div class="melt-faqs__list">
      {%- if use_list -%}
        {%- comment -%} faq_list is set at the top of the section (Automatic). {%- endcomment -%}
        {%- for item in faq_list -%}
          {%- liquid
            assign faq_question = item.question.value
            assign faq_answer_text = item.answer.value
            assign faq_answer = ''
            if faq_answer_text != blank
              assign faq_answer = faq_answer_text | escape | newline_to_br | prepend: '<p>' | append: '</p>'
            endif
          -%}
          {%- render 'melt-faq-item',
            question: faq_question,
            answer: faq_answer,
            color_scheme: section.settings.item_color_scheme
          -%}
          {%- if faq_question != blank and faq_answer != blank -%}
            {%- capture faq_entry -%}{"@type":"Question","name":{{ faq_question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_answer_text | json }}}}{%- endcapture -%}
            {%- if faq_json != blank -%}{%- assign faq_json = faq_json | append: ',' -%}{%- endif -%}
            {%- assign faq_json = faq_json | append: faq_entry -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- render 'melt-faq-item',
            question: block.settings.question,
            answer: block.settings.answer,
            color_scheme: section.settings.item_color_scheme,
            attributes: block.shopify_attributes
          -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- capture faq_entry -%}{"@type":"Question","name":{{ block.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | json }}}}{%- endcapture -%}
            {%- if faq_json != blank -%}{%- assign faq_json = faq_json | append: ',' -%}{%- endif -%}
            {%- assign faq_json = faq_json | append: faq_entry -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.structured_data and faq_json != blank -%}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_json }}]}
  </script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.melt_faqs.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.melt_faqs.settings.header_intro.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.melt_faqs.settings.title.label",
      "default": "t:sections.melt_faqs.settings.title.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.melt_faqs.settings.description.label",
      "default": "t:sections.melt_faqs.settings.description.default"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.collection-list.settings.cta_label.label",
      "default": "t:sections.melt_faqs.settings.link_label.default"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:sections.collection-list.settings.cta_link.label"
    },
    {
      "type": "checkbox",
      "id": "link_arrow",
      "default": true,
      "label": "t:sections.collection-list.settings.cta_arrow.label"
    },
    {
      "type": "color_scheme",
      "id": "link_color_scheme",
      "default": "scheme-2",
      "label": "t:sections.collection-list.settings.cta_color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.melt_faqs.settings.header_questions.content"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:sections.melt_faqs.settings.source.label",
      "info": "t:sections.melt_faqs.settings.source.info",
      "options": [
        {
          "value": "manual",
          "label": "t:sections.melt_faqs.settings.source.options__manual.label"
        },
        {
          "value": "automatic",
          "label": "t:sections.melt_faqs.settings.source.options__automatic.label"
        }
      ],
      "default": "manual"
    },
    {
      "type": "color_scheme",
      "id": "item_color_scheme",
      "default": "scheme-2",
      "label": "t:sections.melt_faqs.settings.item_color_scheme.label",
      "info": "t:sections.melt_faqs.settings.item_color_scheme.info"
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "default": true,
      "label": "t:sections.melt_faqs.settings.structured_data.label",
      "info": "t:sections.melt_faqs.settings.structured_data.info"
    },
    {
      "type": "header",
      "content": "t:sections.melt_faqs.settings.header_section.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.melt_faqs.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.melt_faqs.blocks.question.settings.question.label",
          "default": "t:sections.melt_faqs.blocks.question.settings.question.default"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.melt_faqs.blocks.question.settings.answer.label",
          "default": "t:sections.melt_faqs.blocks.question.settings.answer.default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_faqs.name",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
