{%- comment -%}
  Melt: Proof strip (Wireframes — Proposition + form · 02 Who we have made for).
  A row of client logos (image, or the name as text until a logo is uploaded) with a footnote.
{%- endcomment -%}
{{ 'component-eyebrow.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-logo-strip.css' | asset_url | stylesheet_tag }}
<div class="melt-logos color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width melt-logos__inner">
    {%- render 'melt-eyebrow', text: section.settings.eyebrow, class: 'melt-logos__eyebrow' -%}
    <ul class="melt-logos__list list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="melt-logos__item" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '200px', alt: block.settings.name }}
          {%- else -%}
            <span>{{ block.settings.name | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.footnote != blank -%}
      <p class="melt-logos__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.melt_logo_strip.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.melt_logo_strip.settings.eyebrow.label",
      "default": "We have made gifts for"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:sections.melt_logo_strip.settings.footnote.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.melt_logo_strip.blocks.logo.name",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.melt_logo_strip.blocks.logo.settings.name.label",
          "info": "t:sections.melt_logo_strip.blocks.logo.settings.name.info"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.melt_logo_strip.blocks.logo.settings.logo.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_logo_strip.presets.name"
    }
  ]
}
{% endschema %}
