{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-eyebrow.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- comment -%} Melt: heading margins (75% on mobile), desktop side padding, card overrides. {%- endcomment -%}
  #FeaturedCollection-{{ section.id }} .collection__title {
    margin-top: {{ section.settings.heading_margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.heading_margin_bottom | times: 0.75 | round: 0 }}px;
  }

  {%- comment -%}
    Left/right margin goes on the heading's children: .collection__title is itself the
    page-width container, so margins on it would break its centring.
  {%- endcomment -%}
  #FeaturedCollection-{{ section.id }} .collection__title > * {
    margin-left: {{ section.settings.heading_margin_sides | times: 0.75 | round: 0 }}px;
    margin-right: {{ section.settings.heading_margin_sides | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #FeaturedCollection-{{ section.id }} .collection__title {
      margin-top: {{ section.settings.heading_margin_top }}px;
      margin-bottom: {{ section.settings.heading_margin_bottom }}px;
    }

    #FeaturedCollection-{{ section.id }} .collection__title > * {
      margin-left: {{ section.settings.heading_margin_sides }}px;
      margin-right: {{ section.settings.heading_margin_sides }}px;
    }

    #FeaturedCollection-{{ section.id }} .page-width,
    #FeaturedCollection-{{ section.id }} .page-width-desktop {
      padding-left: {{ section.settings.padding_sides }}px;
      padding-right: {{ section.settings.padding_sides }}px;
    }
  }

  {%- if section.settings.card_style != 'theme' %}
    #FeaturedCollection-{{ section.id }} {
      --product-card-image-padding: {{ section.settings.card_image_padding | divided_by: 10.0 }}rem;
      --product-card-corner-radius: {{ section.settings.card_radius | divided_by: 10.0 }}rem;
      {%- if section.settings.card_border_width > 0 %}
        --product-card-border-width: {{ section.settings.card_border_width | divided_by: 10.0 }}rem;
        --product-card-border-opacity: 1;
      {%- endif %}
    }
  {%- endif %}

{%- endstyle -%}

{%- comment -%}
  Collection source. "Collection selected above" uses the picker as normal. On product pages the
  section can follow the product instead:
    product_fragrance     - the product's fragrance collection ("Also comes as")
    product_scent_family  - the fragrance's scent family collection ("If you like"),
                            one product per fragrance, leaving out the product's own fragrance,
                            preferring the same format as the product being viewed
  Either way the product being viewed is never shown. In the eyebrow, heading and link label,
  [fragrance] and [family] are replaced with the product's fragrance and scent family names.
  If a product has no fragrance (e.g. holders), a section following the product is not shown.
{%- endcomment -%}
{%- liquid
  assign fc_collection = section.settings.collection
  assign fc_source = section.settings.collection_source | default: 'manual'
  assign fc_current_id = 0
  assign fc_fragrance = nil
  if product
    assign fc_current_id = product.id
    assign fc_fragrance = product.metafields.custom.fragrance.value
  endif
  assign fc_fragrance_name = fc_fragrance.fragrance.value | default: ''
  assign fc_fragrance_handle = fc_fragrance.system.handle | default: ''

  assign fc_hide = false
  if fc_source == 'product_fragrance' and product
    if fc_fragrance_handle != blank
      assign fc_collection = collections[fc_fragrance_handle]
    else
      assign fc_hide = true
    endif
  elsif fc_source == 'product_scent_family' and product
    assign fc_family_handle = fc_fragrance.scent_type.value.system.handle | default: ''
    if fc_family_handle != blank
      assign fc_collection = collections[fc_family_handle]
    else
      assign fc_hide = true
    endif
  endif
  if fc_collection == blank or fc_collection.products_count == 0
    if fc_source != 'manual' and product
      assign fc_hide = true
    endif
  endif
  assign fc_family_name = ''
  if fc_source == 'product_scent_family'
    assign fc_family_name = fc_collection.title
  endif

  assign fc_eyebrow = section.settings.heading_eyebrow | replace: '[fragrance]', fc_fragrance_name | replace: '[family]', fc_family_name
  assign fc_title = section.settings.title | replace: '[fragrance]', fc_fragrance_name | replace: '[family]', fc_family_name
  assign fc_cta_label = section.settings.cta_label | replace: '[fragrance]', fc_fragrance_name | replace: '[family]', fc_family_name
  assign fc_cta_link = section.settings.cta_link
  if fc_source != 'manual' and product and fc_collection != blank
    assign fc_cta_link = fc_collection.url
  endif

  # Pick the products first, so the slider counts and "View all" match what is shown.
  # Product IDs are kept in a comma-wrapped string (",123,456,") so the render loop can test membership.
  assign fc_ids = ','
  assign fc_seen = ','
  assign products_to_display = 0
  assign fc_eligible = 0
  if fc_source == 'product_scent_family'
    # One product per other fragrance in the family. Pass 1 takes each fragrance's product in the
    # same format as the page (Short & Fat -> other Short & Fats); pass 2 fills in any fragrance
    # that has no product in that format with its first product instead.
    assign fc_format = ''
    if product
      assign fc_format = product.metafields.custom.short_title.value.system.handle | default: ''
    endif
    for fc_pass in (1..2)
      if fc_pass == 1 and fc_format == blank
        continue
      endif
      for item in fc_collection.products limit: 50
        if item.id == fc_current_id
          continue
        endif
        assign item_fragrance = item.metafields.custom.fragrance.value.system.handle | default: item.handle
        if item_fragrance == fc_fragrance_handle
          continue
        endif
        if fc_pass == 1
          assign item_format = item.metafields.custom.short_title.value.system.handle | default: ''
          if item_format != fc_format
            continue
          endif
        endif
        assign seen_key = ',' | append: item_fragrance | append: ','
        if fc_seen contains seen_key
          continue
        endif
        assign fc_seen = fc_seen | append: item_fragrance | append: ','
        assign fc_eligible = fc_eligible | plus: 1
        if products_to_display < section.settings.products_to_show
          assign fc_ids = fc_ids | append: item.id | append: ','
          assign products_to_display = products_to_display | plus: 1
        endif
      endfor
    endfor
  else
    for item in fc_collection.products limit: 50
      if item.id == fc_current_id
        continue
      endif
      assign fc_eligible = fc_eligible | plus: 1
      if products_to_display < section.settings.products_to_show
        assign fc_ids = fc_ids | append: item.id | append: ','
        assign products_to_display = products_to_display | plus: 1
      endif
    endfor
  endif
  if fc_eligible > products_to_display
    assign more_in_collection = true
  endif
  if products_to_display == 0 and fc_source != 'manual' and product
    assign fc_hide = true
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and products_to_display > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign max_columns_to_show = columns_mobile_int
  if columns_desktop_int > columns_mobile_int
    assign max_columns_to_show = columns_desktop_int
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and products_to_display > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif

  # Melt card overrides (Theme default = Theme settings → Product cards)
  assign card_style = settings.card_style
  assign card_style_override = ''
  assign card_color_scheme_override = ''
  if section.settings.card_style != 'theme'
    assign card_style = section.settings.card_style
    assign card_style_override = section.settings.card_style
    if section.settings.card_style == 'card'
      assign card_color_scheme_override = section.settings.card_color_scheme
    endif
  endif
-%}

{%- unless fc_hide -%}
<div
  id="FeaturedCollection-{{ section.id }}"
  class="featured-collection-section melt-cards featured-collection-section--heading-{{ section.settings.heading_alignment }} melt-section-bg melt-cards--media-radius melt-cards--name-{{ section.settings.card_name_size }}{% if section.settings.card_style != 'theme' and section.settings.card_border_width > 0 %} melt-cards--outline{% endif %}{% if section.settings.price_rating_row %} melt-cards--price-row{% endif %} color-{{ section.settings.color_scheme }} isolate gradient"
>
  {%- render 'melt-section-background', image: section.settings.background_image -%}
  <div
    class="collection{% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %} section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% endif %}{% if show_desktop_slider %} collection__title--desktop-slider{% endif %}">
      <div class="featured-collection-section__heading">
      {%- render 'melt-eyebrow',
        text: fc_eyebrow,
        color: section.settings.heading_eyebrow_color,
        class: 'featured-collection-section__eyebrow'
      -%}
      {%- if fc_title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ fc_title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank
        or section.settings.show_description
        and fc_collection.description != empty
      -%}
        <div class="collection__description {{ section.settings.description_style }} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.show_description -%}
            {{ fc_collection.description }}
          {%- else -%}
            {{ section.settings.description -}}
          {%- endif %}
        </div>
      {%- endif -%}
      </div>
      {%- render 'melt-heading-link',
        label: fc_cta_label,
        url: fc_cta_link,
        color_scheme: section.settings.cta_color_scheme,
        show_arrow: section.settings.cta_arrow
      -%}
    </div>

    <slider-component class="slider-mobile-gutter{% if section.settings.full_width %} slider-component-full-width{% endif %}{% if show_mobile_slider == false %} page-width{% endif %}{% if show_desktop_slider == false and section.settings.full_width == false %} page-width-desktop{% endif %}{% if show_desktop_slider %} slider-component-desktop{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        id="Slider-{{ section.id }}"
        data-id="{{ section.id }}"
        class="grid product-grid contains-card contains-card--product{% if card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop{% if fc_collection == blank %} grid--2-col-tablet-down{% else %} grid--{{ section.settings.columns_mobile }}-col-tablet-down{% endif %}{% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
        {% assign skip_card_product_styles = false %}

        {%- if products_to_display > 0 -%}
          {% assign lazy_load = false %}
          {% assign fc_index = 0 %}
            {%- for item in fc_collection.products limit: 50 -%}
              {%- assign item_key = ',' | append: item.id | append: ',' -%}
              {%- unless fc_ids contains item_key -%}
                {%- continue -%}
              {%- endunless -%}
              {%- assign fc_index = fc_index | plus: 1 -%}
              {% if lazy_load == false and fc_index > max_columns_to_show %}
                {% assign lazy_load = true %}
              {% endif %}
              <li
                id="Slide-{{ section.id }}-{{ fc_index }}"
                class="grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ fc_index }};"
                {% endif %}
              >
                {% render 'card-product',
                  card_product: item,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  lazy_load: lazy_load,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: section.settings.quick_add,
                  card_style_override: card_style_override,
                  card_color_scheme_override: card_color_scheme_override,
                  show_type_eyebrow: section.settings.show_type_eyebrow,
                  eyebrow_color: section.settings.eyebrow_color,
                  show_scent_notes: true,
                  product_view_context: 'collection'
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.columns_desktop) -%}
            <li
              class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% liquid
                assign ridx = forloop.rindex
                case ridx
                  when 5
                    assign ridx = 1
                  when 6
                    assign ridx = 2
                endcase
              %}
              {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
              {% render 'card-product',
                show_vendor: section.settings.show_vendor,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                lazy_load: false,
                card_style_override: card_style_override,
                card_color_scheme_override: card_color_scheme_override,
                placeholder_image: placeholder_image
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ products_to_display }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.show_view_all and more_in_collection -%}
      <div class="center collection__view-all{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <a
          href="{{ fc_collection.url }}"
          class="{% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
          aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: fc_collection.title | escape }}"
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</div>

{%- endunless -%}

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "select",
      "id": "collection_source",
      "label": "Collection source",
      "options": [
        { "value": "manual", "label": "Collection selected above" },
        { "value": "product_fragrance", "label": "Product's fragrance" },
        { "value": "product_scent_family", "label": "Product's scent family" }
      ],
      "default": "manual",
      "info": "Product pages only. The product being viewed is left out. Use [fragrance] or [family] in the eyebrow, heading and link label."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_text.content"
    },
    {
      "type": "text",
      "id": "heading_eyebrow",
      "label": "t:sections.featured-collection.settings.heading_eyebrow.label",
      "info": "t:sections.featured-collection.settings.heading_eyebrow.info"
    },
    {
      "type": "color",
      "id": "heading_eyebrow_color",
      "label": "t:sections.all.eyebrow_color.label",
      "info": "t:sections.all.eyebrow_color.info"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.featured-collection.settings.title.default",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.featured-collection.settings.show_description.label",
      "default": false
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
      "options": [
        {
          "value": "body",
          "label": "t:sections.featured-collection.settings.description_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.featured-collection.settings.description_style.options__2.label"
        },
        {
          "value": "uppercase",
          "label": "t:sections.featured-collection.settings.description_style.options__3.label"
        }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.collection-list.settings.heading_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.collection-list.settings.heading_alignment.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.collection-list.settings.heading_alignment.options__center.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:sections.collection-list.settings.heading_margin_top.label",
      "info": "t:sections.collection-list.settings.heading_margin_top.info"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "label": "t:sections.collection-list.settings.heading_margin_bottom.label"
    },
    {
      "type": "range",
      "id": "heading_margin_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:sections.collection-list.settings.heading_margin_sides.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_cta.content",
      "info": "t:sections.collection-list.settings.header_cta.info"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.collection-list.settings.cta_label.label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.collection-list.settings.cta_link.label"
    },
    {
      "type": "checkbox",
      "id": "cta_arrow",
      "default": true,
      "label": "t:sections.collection-list.settings.cta_arrow.label"
    },
    {
      "type": "color_scheme",
      "id": "cta_color_scheme",
      "default": "scheme-1",
      "label": "t:sections.collection-list.settings.cta_color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_collection.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
