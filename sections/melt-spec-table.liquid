{%- comment -%}
  Melt: heading + text on the left, a simple two-column table on the right
  (Wireframes — Subscribe & Save · 05 How often). Rows are blocks: title, small note, value.
{%- endcomment -%}
{{ 'section-melt-spec-table.css' | asset_url | stylesheet_tag }}
<div class="melt-spec color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width melt-spec__inner">
    <div class="melt-spec__copy">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <dl class="melt-spec__table">
      {%- for block in section.blocks -%}
        <div class="melt-spec__row" {{ block.shopify_attributes }}>
          <dt><span class="melt-spec__title">{{ block.settings.title | escape }}</span>{%- if block.settings.note != blank -%}<span class="melt-spec__note">{{ block.settings.note | escape }}</span>{%- endif -%}</dt>
          <dd>{{ block.settings.value | escape }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.melt_spec_table.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.melt_spec_table.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.melt_spec_table.settings.text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.melt_spec_table.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.melt_spec_table.blocks.row.settings.title.label"
        },
        {
          "type": "text",
          "id": "note",
          "label": "t:sections.melt_spec_table.blocks.row.settings.note.label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.melt_spec_table.blocks.row.settings.value.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_spec_table.presets.name"
    }
  ]
}
{% endschema %}
