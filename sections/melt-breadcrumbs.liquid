{%- comment -%}
  Breadcrumbs: Home / collection / product, and equivalents for collections, pages, blogs,
  articles, search and cart. Replaces the AI-generated "Page breadcrumbs" block.
  Also outputs schema.org BreadcrumbList JSON-LD matching the visible trail.

  Product trail: the collection the shopper came through (collection-scoped URL), otherwise the
  product's first collection. Shopify collections have no hierarchy, so this is one level.
{%- endcomment -%}

{%- style -%}
  #Breadcrumbs-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    font-size: {{ section.settings.font_size }}px;
    {%- if section.settings.text_color != blank and section.settings.text_color.alpha != 0 %}
      --breadcrumb-text: {{ section.settings.text_color }};
    {%- endif %}
    {%- if section.settings.link_color != blank and section.settings.link_color.alpha != 0 %}
      --breadcrumb-link: {{ section.settings.link_color }};
    {%- endif %}
    {%- if section.settings.link_hover_color != blank and section.settings.link_hover_color.alpha != 0 %}
      --breadcrumb-link-hover: {{ section.settings.link_hover_color }};
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    #Breadcrumbs-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'section-melt-breadcrumbs.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Build the trail as parallel lists of titles and URLs (the last item is the current page, no link).
  assign sep = '|||'
  assign titles = section.settings.home_label | default: 'Home'
  assign urls = routes.root_url

  case request.page_type
    when 'product'
      assign crumb_collection = collection
      if crumb_collection == blank
        assign crumb_collection = product.collections | first
      endif
      if crumb_collection != blank
        assign titles = titles | append: sep | append: crumb_collection.title
        assign urls = urls | append: sep | append: crumb_collection.url
      endif
      assign titles = titles | append: sep | append: product.title
      assign urls = urls | append: sep | append: product.url
    when 'collection'
      assign titles = titles | append: sep | append: collection.title
      assign urls = urls | append: sep | append: collection.url
    when 'page'
      assign titles = titles | append: sep | append: page.title
      assign urls = urls | append: sep | append: page.url
    when 'blog'
      assign titles = titles | append: sep | append: blog.title
      assign urls = urls | append: sep | append: blog.url
    when 'article'
      assign titles = titles | append: sep | append: blog.title | append: sep | append: article.title
      assign urls = urls | append: sep | append: blog.url | append: sep | append: article.url
    when 'search'
      assign titles = titles | append: sep | append: section.settings.search_label
      assign urls = urls | append: sep | append: routes.search_url
    when 'cart'
      assign titles = titles | append: sep | append: section.settings.cart_label
      assign urls = urls | append: sep | append: routes.cart_url
  endcase

  assign title_list = titles | split: sep
  assign url_list = urls | split: sep
-%}

{%- if title_list.size > 1 -%}
  <div
    id="Breadcrumbs-{{ section.id }}"
    class="melt-breadcrumbs color-{{ section.settings.color_scheme }} gradient"
  >
    <nav
      class="melt-breadcrumbs__nav page-width{% if section.settings.width == 'full' %} melt-breadcrumbs__nav--full{% endif %}"
      aria-label="{{ 'sections.breadcrumbs.label' | t }}"
    >
      <ol class="melt-breadcrumbs__list list-unstyled" role="list">
        {%- for title in title_list -%}
          <li class="melt-breadcrumbs__item">
            {%- if forloop.last -%}
              <span class="melt-breadcrumbs__current" aria-current="page">{{ title | escape }}</span>
            {%- else -%}
              <a class="melt-breadcrumbs__link" href="{{ url_list[forloop.index0] }}">{{ title | escape }}</a>
              <span class="melt-breadcrumbs__separator" aria-hidden="true">{{ section.settings.separator | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </nav>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {%- for title in title_list -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "name": {{ title | json }},
            "item": {{ request.origin | append: url_list[forloop.index0] | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.melt_breadcrumbs.name",
  "tag": "section",
  "class": "section melt-breadcrumbs-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.melt_breadcrumbs.settings.width.label",
      "options": [
        {
          "value": "container",
          "label": "t:sections.melt_breadcrumbs.settings.width.options__container.label"
        },
        {
          "value": "full",
          "label": "t:sections.melt_breadcrumbs.settings.width.options__full.label"
        }
      ],
      "default": "container"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "t:sections.melt_breadcrumbs.settings.home_label.label",
      "default": "t:sections.melt_breadcrumbs.settings.home_label.default"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "t:sections.melt_breadcrumbs.settings.separator.label",
      "default": "/"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "t:sections.melt_breadcrumbs.settings.search_label.label",
      "default": "t:sections.melt_breadcrumbs.settings.search_label.default"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "t:sections.melt_breadcrumbs.settings.cart_label.label",
      "default": "t:sections.melt_breadcrumbs.settings.cart_label.default"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:sections.melt_breadcrumbs.settings.font_size.label",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.melt_breadcrumbs.settings.text_color.label",
      "info": "t:sections.melt_breadcrumbs.settings.text_color.info"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "t:sections.melt_breadcrumbs.settings.link_color.label"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "t:sections.melt_breadcrumbs.settings.link_hover_color.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_breadcrumbs.name"
    }
  ]
}
{% endschema %}
