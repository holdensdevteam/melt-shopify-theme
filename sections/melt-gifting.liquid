{{ 'section-melt-gifting.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Gifting: a large featured collection on the left; on the right, a labelled pair of image tiles
  (e.g. Shop by recipient) above a labelled row of three text buttons (e.g. Shop by price).
  Every tile/button is a collection link showing the collection's title (overridable where noted).
{%- endcomment -%}

{%- style -%}
  #Gifting-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --gifting-featured-border: {{ section.settings.featured_border_width }}px;
  }

  #Gifting-{{ section.id }} .melt-gifting__header {
    margin: {{ section.settings.heading_margin_top | times: 0.75 | round: 0 }}px {{ section.settings.heading_margin_sides | times: 0.75 | round: 0 }}px {{ section.settings.heading_margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #Gifting-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #Gifting-{{ section.id }} .melt-gifting__header {
      margin: {{ section.settings.heading_margin_top }}px {{ section.settings.heading_margin_sides }}px {{ section.settings.heading_margin_bottom }}px;
    }

    #Gifting-{{ section.id }} .melt-gifting__inner {
      padding-left: {{ section.settings.padding_sides }}px;
      padding-right: {{ section.settings.padding_sides }}px;
      {%- if section.settings.content_width == 'full' %}
        max-width: none;
      {%- endif %}
    }
  }
{%- endstyle -%}

{%- liquid
  assign featured = section.settings.featured_collection
  assign featured_title = section.settings.featured_title | default: featured.title | default: ''
  if featured_title == blank
    assign featured_title = 'onboarding.collection_title' | t
  endif
  assign featured_url = section.settings.featured_link | default: featured.url

  assign recipients = '1,2' | split: ','
  assign prices = '1,2,3' | split: ','
-%}

<div
  id="Gifting-{{ section.id }}"
  class="melt-gifting melt-section-bg melt-gifting--heading-{{ section.settings.heading_alignment }} melt-gifting--image-{{ section.settings.featured_image_ratio }} color-{{ section.settings.color_scheme }} gradient"
>
  {%- render 'melt-section-background', image: section.settings.background_image -%}

  <div class="melt-gifting__inner page-width">
    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="melt-gifting__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.title != blank -%}
          <h2 class="melt-gifting__title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="melt-gifting__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="melt-gifting__grid{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- comment -%} Featured collection {%- endcomment -%}
      <div class="melt-gifting__featured color-{{ section.settings.featured_color_scheme }} gradient">
        <a
          class="melt-gifting__featured-media"
          {% if featured.url != blank %}
            href="{{ featured.url }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          tabindex="-1"
          aria-hidden="true"
        >
          {%- if featured.featured_image -%}
            {{
              featured.featured_image
              | image_url: width: 1800
              | image_tag:
                widths: '450, 650, 900, 1200, 1500, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                alt: ''
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
        <div class="melt-gifting__featured-content">
          <h3 class="melt-gifting__featured-title">
            {%- if featured.url != blank -%}
              <a href="{{ featured.url }}" class="full-unstyled-link">{{ featured_title | escape }}</a>
            {%- else -%}
              {{ featured_title | escape }}
            {%- endif -%}
          </h3>
          {%- if section.settings.featured_subtitle != blank -%}
            <p class="melt-gifting__featured-subtitle">{{ section.settings.featured_subtitle | escape }}</p>
          {%- endif -%}
          {%- if section.settings.featured_link_label != blank -%}
            <a
              class="button button--primary melt-arrow-button melt-gifting__featured-button"
              {% if featured_url != blank %}
                href="{{ featured_url }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              <span>{{ section.settings.featured_link_label | escape }}</span>
              {%- if section.settings.featured_link_arrow -%}
                <span class="melt-arrow-button__arrow">{{ 'icon-arrow-long.svg' | inline_asset_content }}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="melt-gifting__side">
        {%- comment -%} Upper: image tiles {%- endcomment -%}
        <div class="melt-gifting__group melt-gifting__group--tiles">
          {%- render 'melt-heading-link',
            label: section.settings.recipient_label,
            color_scheme: section.settings.label_color_scheme,
            as_heading: true
          -%}
          <ul class="melt-gifting__tiles list-unstyled" role="list">
            {%- for i in recipients -%}
              {%- liquid
                assign collection_key = 'recipient_collection_' | append: i
                assign title_key = 'recipient_title_' | append: i
                assign tile_collection = section.settings[collection_key]
                assign tile_title = section.settings[title_key] | default: tile_collection.title
                if tile_title == blank
                  assign tile_title = 'onboarding.collection_title' | t
                endif
              -%}
              <li>
                <a
                  class="melt-gifting__tile"
                  {% if tile_collection.url != blank %}
                    href="{{ tile_collection.url }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                >
                  {%- if tile_collection.featured_image -%}
                    {{
                      tile_collection.featured_image
                      | image_url: width: 1000
                      | image_tag:
                        widths: '300, 450, 600, 800, 1000',
                        sizes: '(min-width: 990px) 25vw, 50vw',
                        loading: 'lazy',
                        alt: '',
                        class: 'melt-gifting__tile-image'
                    }}
                  {%- else -%}
                    {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg melt-gifting__tile-image' }}
                  {%- endif -%}
                  <span class="melt-gifting__tile-label color-{{ section.settings.recipient_color_scheme }}">
                    {{- tile_title | escape -}}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- comment -%} Lower: text buttons {%- endcomment -%}
        <div class="melt-gifting__group melt-gifting__group--buttons">
          {%- render 'melt-heading-link',
            label: section.settings.price_label,
            color_scheme: section.settings.label_color_scheme,
            as_heading: true
          -%}
          <ul class="melt-gifting__buttons list-unstyled" role="list">
            {%- for i in prices -%}
              {%- liquid
                assign collection_key = 'price_collection_' | append: i
                assign button_collection = section.settings[collection_key]
                assign button_title = button_collection.title
                if button_title == blank
                  assign button_title = 'onboarding.collection_title' | t
                endif
              -%}
              <li>
                <a
                  class="melt-gifting__button color-{{ section.settings.price_color_scheme }}"
                  {% if button_collection.url != blank %}
                    href="{{ button_collection.url }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                >
                  {{- button_title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.melt_gifting.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.melt_gifting.settings.header_heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.melt_gifting.settings.title.label",
      "default": "t:sections.melt_gifting.settings.title.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.collection-list.settings.description.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.collection-list.settings.heading_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.collection-list.settings.heading_alignment.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.collection-list.settings.heading_alignment.options__center.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:sections.collection-list.settings.heading_margin_top.label",
      "info": "t:sections.collection-list.settings.heading_margin_top.info"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40,
      "label": "t:sections.collection-list.settings.heading_margin_bottom.label"
    },
    {
      "type": "range",
      "id": "heading_margin_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:sections.collection-list.settings.heading_margin_sides.label"
    },
    {
      "type": "header",
      "content": "t:sections.melt_gifting.settings.header_featured.content"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "t:sections.melt_gifting.settings.featured_collection.label"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "t:sections.melt_gifting.settings.featured_title.label",
      "info": "t:sections.melt_gifting.settings.featured_title.info"
    },
    {
      "type": "text",
      "id": "featured_subtitle",
      "label": "t:sections.melt_gifting.settings.featured_subtitle.label"
    },
    {
      "type": "select",
      "id": "featured_image_ratio",
      "label": "t:sections.melt_gifting.settings.featured_image_ratio.label",
      "options": [
        {
          "value": "wide",
          "label": "t:sections.melt_gifting.settings.featured_image_ratio.options__wide.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.melt_gifting.settings.featured_image_ratio.options__landscape.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.melt_gifting.settings.featured_image_ratio.options__adapt.label"
        }
      ],
      "default": "wide"
    },
    {
      "type": "text",
      "id": "featured_link_label",
      "label": "t:sections.melt_gifting.settings.featured_link_label.label",
      "default": "t:sections.melt_gifting.settings.featured_link_label.default"
    },
    {
      "type": "url",
      "id": "featured_link",
      "label": "t:sections.melt_gifting.settings.featured_link.label",
      "info": "t:sections.melt_gifting.settings.featured_link.info"
    },
    {
      "type": "checkbox",
      "id": "featured_link_arrow",
      "default": true,
      "label": "t:sections.collection-list.settings.cta_arrow.label"
    },
    {
      "type": "color_scheme",
      "id": "featured_color_scheme",
      "default": "scheme-1",
      "label": "t:sections.melt_gifting.settings.featured_color_scheme.label",
      "info": "t:sections.melt_gifting.settings.featured_color_scheme.info"
    },
    {
      "type": "range",
      "id": "featured_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "label": "t:sections.melt_gifting.settings.featured_border_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.melt_gifting.settings.header_right.content",
      "info": "t:sections.melt_gifting.settings.header_right.info"
    },
    {
      "type": "color_scheme",
      "id": "label_color_scheme",
      "default": "scheme-1",
      "label": "t:sections.melt_gifting.settings.label_color_scheme.label"
    },
    {
      "type": "text",
      "id": "recipient_label",
      "label": "t:sections.melt_gifting.settings.recipient_label.label",
      "default": "t:sections.melt_gifting.settings.recipient_label.default"
    },
    {
      "type": "collection",
      "id": "recipient_collection_1",
      "label": "t:sections.melt_gifting.settings.recipient_collection_1.label"
    },
    {
      "type": "text",
      "id": "recipient_title_1",
      "label": "t:sections.melt_gifting.settings.recipient_title.label",
      "info": "t:sections.melt_gifting.settings.featured_title.info"
    },
    {
      "type": "collection",
      "id": "recipient_collection_2",
      "label": "t:sections.melt_gifting.settings.recipient_collection_2.label"
    },
    {
      "type": "text",
      "id": "recipient_title_2",
      "label": "t:sections.melt_gifting.settings.recipient_title.label",
      "info": "t:sections.melt_gifting.settings.featured_title.info"
    },
    {
      "type": "color_scheme",
      "id": "recipient_color_scheme",
      "default": "scheme-1",
      "label": "t:sections.melt_gifting.settings.recipient_color_scheme.label"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "t:sections.melt_gifting.settings.price_label.label",
      "default": "t:sections.melt_gifting.settings.price_label.default"
    },
    {
      "type": "collection",
      "id": "price_collection_1",
      "label": "t:sections.melt_gifting.settings.price_collection_1.label"
    },
    {
      "type": "collection",
      "id": "price_collection_2",
      "label": "t:sections.melt_gifting.settings.price_collection_2.label"
    },
    {
      "type": "collection",
      "id": "price_collection_3",
      "label": "t:sections.melt_gifting.settings.price_collection_3.label"
    },
    {
      "type": "color_scheme",
      "id": "price_color_scheme",
      "default": "scheme-1",
      "label": "t:sections.melt_gifting.settings.price_color_scheme.label",
      "info": "t:sections.melt_gifting.settings.price_color_scheme.info"
    },
    {
      "type": "header",
      "content": "t:sections.melt_gifting.settings.header_section.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.collection-list.settings.background_image.label",
      "info": "t:sections.collection-list.settings.background_image.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_bottom"
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50,
      "label": "t:sections.collection-list.settings.padding_sides.label",
      "info": "t:sections.collection-list.settings.padding_sides.info"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.collection-list.settings.content_width.label",
      "info": "t:sections.collection-list.settings.content_width.info",
