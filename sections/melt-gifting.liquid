        {
          "value": "page",
          "label": "t:sections.collection-list.settings.content_width.options__page.label"
        },
        {
          "value": "full",
          "label": "t:sections.collection-list.settings.content_width.options__full.label"
        }
      ],
      "default": "page"
    }
  ],
  "presets": [
    {
      "name": "t:sections.melt_gifting.name"
    }
  ]
}
{% endschema %}
