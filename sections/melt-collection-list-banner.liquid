{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'section-main-collection-banner.css' | asset_url | stylesheet_tag }}
{{ 'section-melt-collection-list-banner.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Collection list banner: the Collection banner (sections/main-collection-banner.liquid) for
  pages that list collections — the Fragrances page (templates/page.fragrances.json) and the
  /collections page. Same blocks and layout options; Heading and Text default to the page's own
  title and content instead of a collection's, and the Image block takes a chosen image (or a
  page metafield via dynamic sources), as pages have no image of their own. With no blocks it
  shows just the page title, so the page keeps its H1.
  Blocks render through snippets/melt-collection-banner-block.liquid.
{%- endcomment -%}

{%- liquid
  if page != blank
    assign banner_title = page.title
    assign banner_description = page.content
  else
    assign banner_title = page_title
    assign banner_description = ''
  endif
-%}

{%- liquid
  assign has_media = false
  for block in section.blocks
    if block.type == 'image' or block.type == 'video'
      assign has_media = true
    endif
  endfor
  assign split = false
  if section.settings.layout == 'split' and has_media
    assign split = true
  endif
-%}

{%- style -%}
  #CollectionListBanner-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #CollectionListBanner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- for block in section.blocks -%}
  {%- if block.type == 'breadcrumbs' -%}
    {{ 'section-melt-breadcrumbs.css' | asset_url | stylesheet_tag }}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<div
  id="CollectionListBanner-{{ section.id }}"
  class="melt-banner melt-banner--{% if split %}split melt-banner--media-{{ section.settings.media_position }}{% else %}stacked{% endif %} melt-banner--align-{{ section.settings.text_alignment }} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="melt-banner__inner page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {%- if split -%}
      <div class="melt-banner__content">
        {%- for block in section.blocks -%}
          {%- unless block.type == 'image' or block.type == 'video' -%}
            {%- render 'melt-collection-banner-block', block: block, title: banner_title, description: banner_description -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
      <div class="melt-banner__media-column">
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' or block.type == 'video' -%}
            {%- render 'melt-collection-banner-block', block: block, title: banner_title, description: banner_description -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="melt-banner__content">
        {%- if section.blocks.size == 0 -%}
          <h1 class="melt-banner__heading h1">{{ banner_title | escape }}</h1>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- render 'melt-collection-banner-block', block: block, title: banner_title, description: banner_description -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

