    "safety": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Please remember",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Never leave candles unattended, in a draught, or near a secondary heat source such as a radiator or fireplace – the extra heat, coupled with the heat from the flame, will make your candle unstable, resulting in rapid burning or collapse. Keep them out of reach of children and pets, and place them on a suitable holder, large enough to collect any molten wax.</p>"
          }
        }
      },
      "block_order": [
