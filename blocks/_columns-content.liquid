{%- if block.settings.text != blank or block.settings.html != blank -%}
  <div class="melt-columns__content" {{ block.shopify_attributes }}>
    {%- if block.settings.text != blank -%}
      <div class="rte">{{ block.settings.text }}</div>
    {%- endif -%}
    {%- if block.settings.html != blank -%}
      {{ block.settings.html }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.columns_content.name",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.columns_content.settings.text.label"
    },
    {
      "type": "html",
      "id": "html",
      "label": "t:blocks.columns_content.settings.html.label",
      "info": "t:blocks.columns_content.settings.html.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.columns_content.name"
    }
  ]
}
{% endschema %}
