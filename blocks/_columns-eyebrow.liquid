{%- render 'melt-eyebrow',
  text: block.settings.text,
  color: block.settings.eyebrow_color,
  attributes: block.shopify_attributes
-%}

{% schema %}
{
  "name": "t:blocks.columns_eyebrow.name",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.columns_eyebrow.settings.text.label",
      "default": "t:blocks.columns_eyebrow.settings.text.default"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "t:sections.all.eyebrow_color.label",
      "info": "t:sections.all.eyebrow_color.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.columns_eyebrow.name"
    }
  ]
}
{% endschema %}
