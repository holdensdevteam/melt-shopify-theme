{% comment %}
  Renders a section background image that fills the section behind its content, cropped to fit.
  The section's outer element needs the melt-section-bg class. Styles: src/scss/melt-global.scss.

  Accepts:
  - image: {Object} Image from an image_picker setting. Nothing renders if blank.

  Usage:
  {% render 'melt-section-background', image: section.settings.background_image %}
{% endcomment %}

{%- if image != blank -%}
  {{
    image
    | image_url: width: 3000
    | image_tag:
      class: 'melt-section-bg__image',
      widths: '750, 1100, 1500, 2000, 3000',
      sizes: '100vw',
      loading: 'lazy',
      alt: ''
  }}
{%- endif -%}
